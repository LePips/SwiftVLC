+bool
+swiftvlc_libvlc_media_player_get_sample_buffer_renderer_snapshot(
+    libvlc_media_player_t *p_mi,
+    swiftvlc_sample_buffer_renderer_snapshot_t *snapshot )
+{
+    if (snapshot == NULL)
+        return false;
+
+    *snapshot = (swiftvlc_sample_buffer_renderer_snapshot_t) {
+        .abi_version = 1,
+    };
+
+    _Static_assert((unsigned)swiftvlc_sample_buffer_renderer_current ==
+                   (unsigned)VOUT_DISPLAY_RENDERER_CURRENT,
+                   "renderer current flag mismatch");
+    _Static_assert((unsigned)swiftvlc_sample_buffer_renderer_requires_flush ==
+                   (unsigned)VOUT_DISPLAY_RENDERER_REQUIRES_FLUSH,
+                   "renderer requires-flush flag mismatch");
+    _Static_assert((unsigned)swiftvlc_sample_buffer_renderer_failed ==
+                   (unsigned)VOUT_DISPLAY_RENDERER_FAILED,
+                   "renderer failed flag mismatch");
+    _Static_assert((unsigned)swiftvlc_sample_buffer_renderer_recovery_in_progress ==
+                   (unsigned)VOUT_DISPLAY_RENDERER_RECOVERY_IN_PROGRESS,
+                   "renderer recovery flag mismatch");
+    _Static_assert((unsigned)swiftvlc_sample_buffer_renderer_recovery_sample_available ==
+                   (unsigned)VOUT_DISPLAY_RENDERER_RECOVERY_SAMPLE_AVAILABLE,
+                   "renderer recovery-sample flag mismatch");
+
+    size_t count;
+    vout_thread_t **vouts = vlc_player_vout_HoldAll(p_mi->player, &count);
+    if (vouts == NULL)
+        return false;
+
+    bool found = false;
+    vout_display_renderer_recovery_snapshot newest = { 0 };
+    for (size_t i = 0; i < count; ++i)
+    {
+        vout_display_renderer_recovery_snapshot candidate;
+        if (vout_GetRendererRecoverySnapshot(vouts[i], &candidate) &&
+            (!found || candidate.display_generation >
+                       newest.display_generation))
+        {
+            newest = candidate;
+            found = true;
+        }
+        vout_Release(vouts[i]);
+    }
+    free(vouts);
+
+    if (!found)
+        return false;
+
+    *snapshot = (swiftvlc_sample_buffer_renderer_snapshot_t) {
+        .abi_version = 1,
+        .flags = newest.flags,
+        .display_generation = newest.display_generation,
+        .recovery_episode_count = newest.recovery_episode_count,
+        .recovered_episode_count = newest.recovered_episode_count,
+        .requirement_notification_count =
+            newest.requirement_notification_count,
+        .revocation_notification_count = newest.revocation_notification_count,
+        .decode_failure_notification_count =
+            newest.decode_failure_notification_count,
+        .foreground_check_count = newest.foreground_check_count,
+        .recovery_flush_count = newest.recovery_flush_count,
+        .revocation_flush_count = newest.revocation_flush_count,
+        .failure_flush_count = newest.failure_flush_count,
+        .discontinuity_flush_count = newest.discontinuity_flush_count,
+        .successful_submission_count = newest.successful_submission_count,
+        .recovery_submission_count = newest.recovery_submission_count,
+        .retryable_submission_count = newest.retryable_submission_count,
+        .recovery_sample_failure_count = newest.recovery_sample_failure_count,
+        .permanent_failure_count = newest.permanent_failure_count,
+    };
+    return true;
+}
