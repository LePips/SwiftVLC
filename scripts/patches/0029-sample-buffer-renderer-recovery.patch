+                    sys->rendererFlushInProgress = false;
+                }
+            }
+            sys->rendererRecoveryCheckDeferred = false;
+            vlc_samplebuffer_renderer_reset_boundary(&sys->rendererRecovery);
         }
     }
 }
 
+static bool GetRendererRecoverySnapshot(
+    vout_display_t *vd,
+    vout_display_renderer_recovery_snapshot *snapshot)
+{
+    if (snapshot == NULL)
+        return false;
+
+    VLCSampleBufferDisplay *sys =
+        (__bridge VLCSampleBufferDisplay *)vd->sys;
+    @synchronized(sys.displayLayerLock) {
+        AVSampleBufferVideoRenderer *renderer = sys.observedRenderer;
+        uint64_t generation = sys->rendererGeneration;
+        if (![sys isCurrentRendererLocked:renderer generation:generation])
+            return false;
+
+        bool requiresFlushBeforeStatus =
+            renderer.requiresFlushToResumeDecoding;
+        AVQueuedSampleBufferRenderingStatus status = renderer.status;
+        bool requiresFlushAfterStatus =
+            renderer.requiresFlushToResumeDecoding;
+        bool requiresFlush =
+            requiresFlushBeforeStatus || requiresFlushAfterStatus;
+        uint32_t flags = VOUT_DISPLAY_RENDERER_CURRENT;
+        if (requiresFlush)
+            flags |= VOUT_DISPLAY_RENDERER_REQUIRES_FLUSH;
+        if (status == AVQueuedSampleBufferRenderingStatusFailed)
+            flags |= VOUT_DISPLAY_RENDERER_FAILED;
+        if (sys->rendererFlushInProgress ||
+            sys->rendererRecovery.recovery_episode !=
+                sys->rendererRecovery.recovered_episode)
+            flags |= VOUT_DISPLAY_RENDERER_RECOVERY_IN_PROGRESS;
+        if (sys->recoverySampleBuffer != NULL)
+            flags |= VOUT_DISPLAY_RENDERER_RECOVERY_SAMPLE_AVAILABLE;
+
+        *snapshot = (vout_display_renderer_recovery_snapshot) {
+            .display_generation = generation,
+            .recovery_episode_count =
+                sys->rendererRecovery.recovery_episode,
+            .recovered_episode_count =
+                sys->rendererRecovery.recovered_episode,
+            .requirement_notification_count =
+                sys->rendererRequirementNotificationCount,
+            .revocation_notification_count =
+                sys->rendererRevocationNotificationCount,
+            .decode_failure_notification_count =
+                sys->rendererDecodeFailureNotificationCount,
+            .foreground_check_count = sys->rendererForegroundCheckCount,
+            .recovery_flush_count =
+                sys->rendererRecovery.recovery_flush_count,
+            .revocation_flush_count =
+                sys->rendererRecovery.revocation_flush_count,
+            .failure_flush_count =
+                sys->rendererRecovery.failure_flush_count,
+            .discontinuity_flush_count =
+                sys->rendererDiscontinuityFlushCount,
+            .successful_submission_count =
+                sys->rendererSuccessfulSubmissionCount,
+            .recovery_submission_count =
+                sys->rendererRecovery.recovery_submission_count,
+            .retryable_submission_count =
+                sys->rendererRetryableSubmissionCount,
+            .recovery_sample_failure_count =
+                sys->rendererRecoverySampleFailureCount,
+            .permanent_failure_count =
+                sys->rendererRecovery.permanent_failure_count,
+            .flags = flags,
+        };
+        return true;
+    }
+}
