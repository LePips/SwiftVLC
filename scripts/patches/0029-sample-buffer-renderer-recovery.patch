+static CMSampleBufferRef
+CopyImmediateRecoverySampleBuffer(CMSampleBufferRef source)
+{
+    CVImageBufferRef imageBuffer = CMSampleBufferGetImageBuffer(source);
+    CMFormatDescriptionRef formatDescription =
+        CMSampleBufferGetFormatDescription(source);
+    if (imageBuffer == NULL || formatDescription == NULL)
+        return NULL;
+
+    CMSampleTimingInfo timing = {
+        .duration = kCMTimeInvalid,
+        .presentationTimeStamp = kCMTimeInvalid,
+        .decodeTimeStamp = kCMTimeInvalid,
+    };
+    CMSampleBufferRef copy = NULL;
+    OSStatus status = CMSampleBufferCreateReadyWithImageBuffer(
+        kCFAllocatorDefault, imageBuffer,
+        (CMVideoFormatDescriptionRef)formatDescription, &timing, &copy);
+    if (status != noErr || copy == NULL)
+        return NULL;
+
+    CFArrayRef attachments =
+        CMSampleBufferGetSampleAttachmentsArray(copy, true);
+    if (attachments == NULL || CFArrayGetCount(attachments) == 0)
+    {
+        CFRelease(copy);
+        return NULL;
+    }
+    CFMutableDictionaryRef attachment =
+        (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0);
+    CFDictionarySetValue(attachment, kCMSampleAttachmentKey_DisplayImmediately,
+                         kCFBooleanTrue);
+    return copy;
+}
