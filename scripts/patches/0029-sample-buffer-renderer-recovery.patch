+        @try {
+            [renderer flush];
+        } @finally {
+            rendererFlushInProgress = false;
+        }
+        rendererRecoveryCheckDeferred = false;
+
+        /* A resource revoke can race the status read. Bracket it with two
+         * requires-flush reads before classifying a failure as permanent. */
+        requiresFlushBeforeStatus =
+            renderer.requiresFlushToResumeDecoding;
+        rendererFailed =
+            renderer.status == AVQueuedSampleBufferRenderingStatusFailed;
+        requiresFlushAfterStatus =
+            renderer.requiresFlushToResumeDecoding;
+        gate = vlc_samplebuffer_renderer_evaluate(
+            &rendererRecovery,
+            requiresFlushBeforeStatus || requiresFlushAfterStatus,
+            rendererFailed);
+    }
+
+    if (gate == VLC_SAMPLEBUFFER_RENDERER_RETRYABLE ||
+        gate == VLC_SAMPLEBUFFER_RENDERER_FLUSH_REQUIRED)
+        return VLCSampleBufferRendererGateResultRetryable;
+
+    if (gate == VLC_SAMPLEBUFFER_RENDERER_PERMANENT_FAILURE)
+    {
+        if (rendererRecovery.permanent_failure_count != priorPermanentFailures)
+        {
+            const char *description =
+                renderer.error.localizedDescription.UTF8String;
+            msg_Err(_vd,
+                    "Permanent sample-buffer renderer failure during %s%s%s",
+                    context, description != NULL ? ": " : "",
+                    description != NULL ? description : "");
+        }
+        return VLCSampleBufferRendererGateResultPermanentFailure;
+    }
+
+    return VLCSampleBufferRendererGateResultReady;
+}
+
+- (VLCSampleBufferRendererGateResult)enqueueSampleBufferLocked:
+        (CMSampleBufferRef)sampleBuffer
+        renderer:(AVSampleBufferVideoRenderer *)renderer
+        generation:(uint64_t)generation
+        requireReadiness:(BOOL)requireReadiness
+        rememberForRecovery:(BOOL)rememberForRecovery
+{
+    /* A notification posted synchronously from enqueue cannot be allowed to
+     * flush recursively underneath that enqueue. Defer it, inspect the live
+     * state after the call returns, and re-submit this exact sample once when
+     * that inspection had to flush it out of the renderer queue. */
+    for (unsigned attempt = 0; attempt < 2; ++attempt)
+    {
+        VLCSampleBufferRendererGateResult result =
+            [self prepareRendererLocked:renderer
+                             generation:generation
+                                context:"sample submission"
+                               didFlush:NULL];
+        if (result != VLCSampleBufferRendererGateResultReady)
+        {
+            if (result == VLCSampleBufferRendererGateResultRetryable)
+                vlc_samplebuffer_renderer_increment(
+                    &rendererRetryableSubmissionCount);
+            return result;
+        }
+        if (requireReadiness && !renderer.isReadyForMoreMediaData)
+        {
+            vlc_samplebuffer_renderer_increment(
+                &rendererRetryableSubmissionCount);
+            return VLCSampleBufferRendererGateResultRetryable;
+        }
+
+        rendererRecoveryCheckDeferred = false;
+        rendererEnqueueInProgress = true;
+        @try {
+            [renderer enqueueSampleBuffer:sampleBuffer];
+        } @finally {
+            rendererEnqueueInProgress = false;
+        }
+        /* Always bracket the enqueue with a second live-state evaluation.
+         * A notification delivered on another thread cannot set the deferred
+         * bit while it is blocked on displayLayerLock, but the renderer's
+         * state can already have changed. Strict success is therefore not
+         * committed from the preflight alone. */
+        rendererRecoveryCheckDeferred = false;
+        BOOL didFlush = NO;
+        result = [self prepareRendererLocked:renderer
+                                  generation:generation
+                                     context:"post-enqueue validation"
+                                    didFlush:&didFlush];
+        if (result != VLCSampleBufferRendererGateResultReady)
+        {
+            if (result == VLCSampleBufferRendererGateResultRetryable)
+                vlc_samplebuffer_renderer_increment(
+                    &rendererRetryableSubmissionCount);
+            return result;
+        }
+        if (didFlush)
+        {
+            if (attempt == 0)
+                continue;
+            vlc_samplebuffer_renderer_increment(
+                &rendererRetryableSubmissionCount);
+            return VLCSampleBufferRendererGateResultRetryable;
+        }
+
+        /* The void AVFoundation call is not counted on its own. Commit one
+         * successful submission only after the postflight proves that this
+         * exact attempt was not invalidated by a flush or failed status. */
+        vlc_samplebuffer_renderer_increment(
+            &rendererSuccessfulSubmissionCount);
+        if (rememberForRecovery)
+        {
+            CMSampleBufferRef retained =
+                (CMSampleBufferRef)CFRetain(sampleBuffer);
+            if (recoverySampleBuffer != NULL)
+                CFRelease(recoverySampleBuffer);
+            recoverySampleBuffer = retained;
+        }
+        vlc_samplebuffer_renderer_record_submission(&rendererRecovery);
+        return VLCSampleBufferRendererGateResultReady;
+    }
+
+    vlc_assert_unreachable();
+}
+
+- (void)recoverRendererLocked:(AVSampleBufferVideoRenderer *)renderer
+                   generation:(uint64_t)generation
+                      context:(const char *)context
+{
+    VLCSampleBufferRendererGateResult result =
+        [self prepareRendererLocked:renderer
+                         generation:generation
+                            context:context
+                           didFlush:NULL];
+    if (result != VLCSampleBufferRendererGateResultReady ||
+        rendererRecovery.recovery_episode ==
+            rendererRecovery.recovered_episode ||
+        recoverySampleBuffer == NULL)
+        return;
+
+    CMSampleBufferRef immediate =
+        CopyImmediateRecoverySampleBuffer(recoverySampleBuffer);
+    if (immediate == NULL)
+    {
+        vlc_samplebuffer_renderer_increment(
+            &rendererRecoverySampleFailureCount);
+        msg_Err(_vd, "Failed to create immediate renderer recovery sample");
+        return;
+    }
+
+    [self enqueueSampleBufferLocked:immediate
+                           renderer:renderer
+                         generation:generation
+                   requireReadiness:NO
+                rememberForRecovery:NO];
+    CFRelease(immediate);
+}
+
+- (void)installObserversForRendererLocked:
+        (AVSampleBufferVideoRenderer *)renderer
+{
+    NSAssert(_observedRenderer == nil && _rendererRequirementObserver == nil &&
+             _rendererDecodeFailureObserver == nil &&
+             _applicationActiveObserver == nil,
+             @"sample-buffer renderer observers installed twice");
+
+    rendererGeneration = atomic_fetch_add_explicit(
+        &rendererGenerationSource, 1, memory_order_relaxed);
+    if (rendererGeneration == 0)
+        rendererGeneration = atomic_fetch_add_explicit(
+            &rendererGenerationSource, 1, memory_order_relaxed);
+    if (renderer == nil)
+    {
+        msg_Err(_vd, "Installed sample-buffer display layer has no renderer");
+        return;
+    }
+
+    const uint64_t generation = rendererGeneration;
+    _observedRenderer = renderer;
+    __weak VLCSampleBufferDisplay *weakSelf = self;
+    NSNotificationCenter *center = NSNotificationCenter.defaultCenter;
+    _rendererRequirementObserver = [center
+        addObserverForName:
+            AVSampleBufferVideoRendererRequiresFlushToResumeDecodingDidChangeNotification
+        object:renderer
+        queue:nil
+        usingBlock:^(NSNotification *notification) {
+            VLCSampleBufferDisplay *sys = weakSelf;
+            AVSampleBufferVideoRenderer *notifyingRenderer =
+                (AVSampleBufferVideoRenderer *)notification.object;
+            if (sys == nil || notifyingRenderer == nil)
+                return;
+            @synchronized(sys.displayLayerLock) {
+                if (![sys isCurrentRendererLocked:notifyingRenderer
+                                              generation:generation])
+                    return;
+                vlc_samplebuffer_renderer_increment(
+                    &sys->rendererRequirementNotificationCount);
+                if (notifyingRenderer.requiresFlushToResumeDecoding)
+                    vlc_samplebuffer_renderer_increment(
+                        &sys->rendererRevocationNotificationCount);
+                [sys recoverRendererLocked:notifyingRenderer
+                                  generation:generation
+                                     context:"decoder-resource notification"];
+            }
+        }];
+
+    _rendererDecodeFailureObserver = [center
+        addObserverForName:
+            AVSampleBufferVideoRendererDidFailToDecodeNotification
+        object:renderer
+        queue:nil
+        usingBlock:^(NSNotification *notification) {
+            VLCSampleBufferDisplay *sys = weakSelf;
+            AVSampleBufferVideoRenderer *notifyingRenderer =
+                (AVSampleBufferVideoRenderer *)notification.object;
+            if (sys == nil || notifyingRenderer == nil)
+                return;
+            @synchronized(sys.displayLayerLock) {
+                if (![sys isCurrentRendererLocked:notifyingRenderer
+                                              generation:generation])
+                    return;
+                vlc_samplebuffer_renderer_increment(
+                    &sys->rendererDecodeFailureNotificationCount);
+                [sys recoverRendererLocked:notifyingRenderer
+                                  generation:generation
+                                     context:"decode-failure notification"];
+            }
+        }];
+
+#if !TARGET_OS_OSX
+    _applicationActiveObserver = [center
+        addObserverForName:UIApplicationDidBecomeActiveNotification
+        object:nil
+        queue:nil
+        usingBlock:^(NSNotification *notification) {
+            VLC_UNUSED(notification);
+            VLCSampleBufferDisplay *sys = weakSelf;
+            if (sys == nil)
+                return;
+            @synchronized(sys.displayLayerLock) {
+                AVSampleBufferVideoRenderer *current = sys.observedRenderer;
+                if (![sys isCurrentRendererLocked:current
+                                              generation:generation])
+                    return;
+                vlc_samplebuffer_renderer_increment(
+                    &sys->rendererForegroundCheckCount);
+                [sys recoverRendererLocked:current
+                                  generation:generation
+                                     context:"application activation"];
+            }
+        }];
+#endif
+}
