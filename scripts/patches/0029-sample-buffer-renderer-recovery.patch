@@ -0,0 +1,119 @@
+/*****************************************************************************
+ * VLCSampleBufferRendererRecovery.h: deterministic renderer recovery state
+ *****************************************************************************
+ * Copyright (C) 2026 VLC authors and VideoLAN
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************
+ * This header intentionally depends only on the C standard library. The
+ * transition policy can therefore be stress-tested without AVFoundation;
+ * production remains responsible for performing a requested flush and then
+ * re-evaluating the renderer's live state before enqueueing.
+ *****************************************************************************/
+
+#ifndef VLC_SAMPLE_BUFFER_RENDERER_RECOVERY_H
+#define VLC_SAMPLE_BUFFER_RENDERER_RECOVERY_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef enum
+{
+    VLC_SAMPLEBUFFER_RENDERER_READY,
+    VLC_SAMPLEBUFFER_RENDERER_FLUSH_REQUIRED,
+    VLC_SAMPLEBUFFER_RENDERER_RETRYABLE,
+    VLC_SAMPLEBUFFER_RENDERER_PERMANENT_FAILURE,
+} vlc_samplebuffer_renderer_gate;
+
+typedef struct
+{
+    uint64_t recovery_episode;
+    uint64_t recovered_episode;
+    uint64_t recovery_flush_count;
+    uint64_t revocation_flush_count;
+    uint64_t failure_flush_count;
+    uint64_t recovery_submission_count;
+    uint64_t permanent_failure_count;
+    bool recovery_flush_latched;
+    bool permanent_failure_latched;
+} vlc_samplebuffer_renderer_recovery_state;
+
+static inline void
+vlc_samplebuffer_renderer_increment(uint64_t *value)
+{
+    if (*value != UINT64_MAX)
+        (*value)++;
+}
+
+/* Both revoked resources and an ordinary failed status require one bounded
+ * flush attempt. requires_flush takes precedence when both are true. A failed
+ * status becomes permanent only if that flush did not reset it to Unknown.
+ * One flush action is emitted per contiguous non-ready interval. */
+static inline vlc_samplebuffer_renderer_gate
+vlc_samplebuffer_renderer_evaluate(
+    vlc_samplebuffer_renderer_recovery_state *state,
+    bool requires_flush, bool failed)
+{
+    if (requires_flush || failed)
+    {
+        if (!state->recovery_flush_latched)
+        {
+            state->recovery_flush_latched = true;
+            state->permanent_failure_latched = false;
+            vlc_samplebuffer_renderer_increment(&state->recovery_episode);
+            vlc_samplebuffer_renderer_increment(&state->recovery_flush_count);
+            if (requires_flush)
+                vlc_samplebuffer_renderer_increment(
+                    &state->revocation_flush_count);
+            else
+                vlc_samplebuffer_renderer_increment(
+                    &state->failure_flush_count);
+            return VLC_SAMPLEBUFFER_RENDERER_FLUSH_REQUIRED;
+        }
+        if (!requires_flush)
+        {
+            if (!state->permanent_failure_latched)
+            {
+                state->permanent_failure_latched = true;
+                vlc_samplebuffer_renderer_increment(
+                    &state->permanent_failure_count);
+            }
+            return VLC_SAMPLEBUFFER_RENDERER_PERMANENT_FAILURE;
+        }
+        return VLC_SAMPLEBUFFER_RENDERER_RETRYABLE;
+    }
+
+    state->recovery_flush_latched = false;
+    state->permanent_failure_latched = false;
+    return VLC_SAMPLEBUFFER_RENDERER_READY;
+}
+
+/* Returns true exactly once for the first successful submission following a
+ * recovery episode. */
+static inline bool
+vlc_samplebuffer_renderer_record_submission(
+    vlc_samplebuffer_renderer_recovery_state *state)
+{
+    if (state->recovery_episode == state->recovered_episode)
+        return false;
+
+    state->recovered_episode = state->recovery_episode;
+    vlc_samplebuffer_renderer_increment(&state->recovery_submission_count);
+    return true;
+}
+
+/* Seek/reset/replace has already discarded the old renderer queue. Retain
+ * cumulative evidence while making the prior episode ineligible for replay. */
+static inline void
+vlc_samplebuffer_renderer_reset_boundary(
+    vlc_samplebuffer_renderer_recovery_state *state)
+{
+    state->recovered_episode = state->recovery_episode;
+    state->recovery_flush_latched = false;
+    state->permanent_failure_latched = false;
+}
+
+#endif /* VLC_SAMPLE_BUFFER_RENDERER_RECOVERY_H */
