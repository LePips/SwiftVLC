+bool vout_GetRendererRecoverySnapshot(
+    vout_thread_t *vout,
+    vout_display_renderer_recovery_snapshot *snapshot)
+{
+    if (snapshot == NULL)
+        return false;
+
+    *snapshot = (vout_display_renderer_recovery_snapshot) { 0 };
+    vout_thread_sys_t *sys = VOUT_THREAD_TO_SYS(vout);
+    if (sys->dummy)
+        return false;
+
+    vlc_queuedmutex_lock(&sys->display_lock);
+    vout_display_t *display = sys->display;
+    bool supported = display != NULL &&
+        vout_display_GetRendererRecoverySnapshot(display, snapshot);
+    vlc_queuedmutex_unlock(&sys->display_lock);
+    return supported;
+}
