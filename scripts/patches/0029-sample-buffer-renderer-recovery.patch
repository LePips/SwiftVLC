+            requiresFlushBeforeStatus || requiresFlushAfterStatus
+            ? "revoked decoder resources" : "failed renderer status";
+        msg_Warn(_vd, "Recovering sample-buffer %s during %s "
+                 "(episode %" PRIu64 ")", reason, context,
