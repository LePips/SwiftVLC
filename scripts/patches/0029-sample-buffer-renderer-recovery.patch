+        return VLCSampleBufferRendererGateResultStale;
+    if (rendererFlushInProgress || rendererEnqueueInProgress)
+    {
+        /* NSNotificationCenter may synchronously re-enter from inside flush
+         * or enqueue. The outer operation re-reads live state before it can
+         * treat the affected sample as accepted. */
+        rendererRecoveryCheckDeferred = true;
+        return VLCSampleBufferRendererGateResultRetryable;
+    }
