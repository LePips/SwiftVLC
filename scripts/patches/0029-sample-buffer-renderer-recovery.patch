+    const uint64_t priorPermanentFailures =
+        rendererRecovery.permanent_failure_count;
+    bool requiresFlushBeforeStatus =
+        renderer.requiresFlushToResumeDecoding;
+    bool rendererFailed =
+        renderer.status == AVQueuedSampleBufferRenderingStatusFailed;
+    bool requiresFlushAfterStatus =
+        renderer.requiresFlushToResumeDecoding;
+    vlc_samplebuffer_renderer_gate gate =
+        vlc_samplebuffer_renderer_evaluate(
+            &rendererRecovery,
+            requiresFlushBeforeStatus || requiresFlushAfterStatus,
+            rendererFailed);
