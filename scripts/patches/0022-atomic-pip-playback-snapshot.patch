+
+bool
+swiftvlc_libvlc_media_player_get_playback_snapshot(
+    libvlc_media_player_t *p_mi,
+    swiftvlc_media_player_playback_snapshot_t *snapshot )
+{
+    if (snapshot == NULL)
+        return false;
+
+    vlc_player_t *player = p_mi->player;
+    vlc_player_Lock(player);
+
+    input_item_t *item = vlc_player_GetCurrentMedia(player);
+    libvlc_media_t *media = item != NULL ? item->libvlc_owner : NULL;
+    if (media != NULL)
+        input_item_Hold(item);
+
+    snapshot->media = media;
+    snapshot->length = media != NULL
+        ? libvlc_time_from_vlc_tick(vlc_player_GetLength(player))
+        : -1;
+    snapshot->time = media != NULL
+        ? libvlc_time_from_vlc_tick(vlc_player_GetTime(player))
+        : -1;
+    snapshot->seekable = media != NULL && vlc_player_CanSeek(player);
+
+    vlc_player_Unlock(player);
+    return media != NULL;
+}
 
