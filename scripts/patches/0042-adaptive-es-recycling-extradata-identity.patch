     return 0;
 }
 
+static int check4(es_out_t *out, DummyEsOut *dummy, FakeESOut *fakees)
+{
+    static const uint8_t extra[] = { 1, 100, 0, 31, 0xff, 0xe1 };
+    static const vlc_fourcc_t codecs[] = {
+        VLC_CODEC_H264, VLC_CODEC_HEVC, VLC_CODEC_VC1, VLC_CODEC_AV1
+    };
+
+    try
+    {
+        for(const vlc_fourcc_t codec : codecs)
+        {
+            es_format_t candidate;
+            es_format_Init(&candidate, VIDEO_ES, codec);
+            candidate.p_extra = malloc(sizeof(extra));
+            if(!candidate.p_extra)
+            {
+                es_format_Clean(&candidate);
+                return 1;
+            }
+            memcpy(candidate.p_extra, extra, sizeof(extra));
+            candidate.i_extra = sizeof(extra);
+
+            const SrcID source = SrcID::make();
+            FakeESOutID original(fakees, &candidate, source);
+            FakeESOutID identical(fakees, &candidate, source);
+            Expect(original.isCompatible(&identical));
+            FakeESOutID discontinuity(fakees, &candidate, SrcID::make());
+            Expect(!original.isCompatible(&discontinuity));
+
+            candidate.i_extra = 0;
+            FakeESOutID missingExtra(fakees, &candidate, source);
+            Expect(!original.isCompatible(&missingExtra));
+            candidate.i_extra = sizeof(extra);
+            candidate.i_extra--;
+            FakeESOutID shorter(fakees, &candidate, source);
+            Expect(!original.isCompatible(&shorter));
+            candidate.i_extra++;
+            static_cast<uint8_t *>(candidate.p_extra)[3] ^= 1;
+            FakeESOutID changed(fakees, &candidate, source);
+            Expect(!original.isCompatible(&changed));
+            es_format_Clean(&candidate);
+        }
+    } catch (...) {
+        return 1;
+    }
+
+    es_format_t fmt;
+    es_format_Init(&fmt, VIDEO_ES, VLC_CODEC_H264);
+    fmt.p_extra = malloc(sizeof(extra));
+    if(!fmt.p_extra)
+    {
+        es_format_Clean(&fmt);
+        return 1;
+    }
+    memcpy(fmt.p_extra, extra, sizeof(extra));
+    fmt.i_extra = sizeof(extra);
+
+    try
+    {
+        es_out_id_t *id = es_out_Add(out, &fmt);
+        Expect(id != nullptr);
+        fakees->commandsQueue()->Commit();
+        fakees->commandsQueue()->Process(drainTimes);
+        Expect(dummy->eslist.size() == 1);
+        dummy->eslist.front()->b_selected = true;
+
+        /* A seek that restarts the adaptive demux with identical codec
+         * configuration must retain the real ES, decoder and video output. */
+        fakees->recycleAll();
+        id = es_out_Add(out, &fmt);
+        Expect(id != nullptr);
+        fakees->commandsQueue()->Commit();
+        fakees->commandsQueue()->Process(drainTimes);
+        Expect(dummy->eslist.size() == 1);
+        fakees->gc();
+        Expect(dummy->eslist.size() == 1);
+        Expect(dummy->eslist.front()->b_selected == true);
+
+        /* Same-sized but different codec configuration must not borrow the
+         * previous decoder. The selected replacement survives collection. */
+        fakees->recycleAll();
+        static_cast<uint8_t *>(fmt.p_extra)[3] ^= 1;
+        id = es_out_Add(out, &fmt);
+        Expect(id != nullptr);
+        fakees->commandsQueue()->Commit();
+        fakees->commandsQueue()->Process(drainTimes);
+        Expect(dummy->eslist.size() == 2);
+        fakees->gc();
+        Expect(dummy->eslist.size() == 1);
+        Expect(dummy->eslist.front()->b_selected == true);
+    } catch (...) {
+        es_format_Clean(&fmt);
+        return 1;
+    }
+
+    es_format_Clean(&fmt);
+    return 0;
+}
