+@interface VLCSampleBufferOverlayCompositor : NSObject
+- (CVPixelBufferRef)copyPixelBufferByCompositing:
+                         (VLCSampleBufferSubpicture *)subpicture
+                                      overBuffer:(CVPixelBufferRef)pixelBuffer
+                                      videoFrame:(CGRect)videoFrame
+                                   displayHeight:(CGFloat)displayHeight
