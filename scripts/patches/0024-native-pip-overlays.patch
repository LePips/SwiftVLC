+
+@implementation VLCSampleBufferOverlayCompositor
+{
+    CIContext *_context;
+    VLCRotatedPixelBufferProvider *_bufferProvider;
+}
+
+- (instancetype)init
+{
+    self = [super init];
+    if (!self)
+        return nil;
+
+    _context = [CIContext contextWithOptions:@{
+        kCIContextCacheIntermediates: @NO,
+    }];
+    _bufferProvider = [VLCRotatedPixelBufferProvider new];
+    return self;
+}
+
+static CIImage *ApplyRegionAlpha(CIImage *image, CGFloat alpha)
+{
+    if (alpha >= 1.0)
+        return image;
+    CGFloat boundedAlpha = fmax(0.0, fmin(1.0, alpha));
+    CIVector *red = [CIVector vectorWithX:boundedAlpha Y:0 Z:0 W:0];
+    CIVector *green = [CIVector vectorWithX:0 Y:boundedAlpha Z:0 W:0];
+    CIVector *blue = [CIVector vectorWithX:0 Y:0 Z:boundedAlpha W:0];
+    CIVector *transparency =
+        [CIVector vectorWithX:0 Y:0 Z:0 W:boundedAlpha];
+    return [image imageByApplyingFilter:@"CIColorMatrix"
+                    withInputParameters:@{
+        @"inputRVector": red,
+        @"inputGVector": green,
+        @"inputBVector": blue,
+        @"inputAVector": transparency,
+    }];
+}
+
+- (CVPixelBufferRef)copyPixelBufferByCompositing:
+                         (VLCSampleBufferSubpicture *)subpicture
+                                      overBuffer:(CVPixelBufferRef)pixelBuffer
+                                      videoFrame:(CGRect)videoFrame
+                                   displayHeight:(CGFloat)displayHeight
+{
+    if (subpicture == nil || subpicture.regions.count == 0 ||
+        CGRectIsEmpty(videoFrame) || displayHeight <= 0.0)
+        return NULL;
+
+    @synchronized(self) {
+        size_t width = CVPixelBufferGetWidth(pixelBuffer);
+        size_t height = CVPixelBufferGetHeight(pixelBuffer);
+        if (width == 0 || height == 0)
+            return NULL;
+
+        CVPixelBufferRef composited =
+            [_bufferProvider provideFromBuffer:pixelBuffer
+                                   outputWidth:width
+                                  outputHeight:height];
+        if (composited == NULL)
+            return NULL;
+
+        CFDictionaryRef attachments = CVBufferCopyAttachments(
+            pixelBuffer, kCVAttachmentMode_ShouldPropagate);
+
+        CIImage *result = [CIImage imageWithCVPixelBuffer:pixelBuffer];
+        CGRect outputBounds = CGRectMake(0, 0, width, height);
+
+        for (VLCSampleBufferSubpictureRegion *region in subpicture.regions) {
+            CGRect frame;
+            if (!vlc_samplebuffer_map_overlay_region(
+                    region.backingFrame, videoFrame, displayHeight,
+                    width, height, &frame))
+                continue;
+
+            size_t imageWidth = CGImageGetWidth(region.image);
+            size_t imageHeight = CGImageGetHeight(region.image);
+            if (imageWidth == 0 || imageHeight == 0)
+                continue;
+
+            CIImage *overlay = [CIImage imageWithCGImage:region.image];
+            CGAffineTransform transform = CGAffineTransformMakeScale(
+                frame.size.width / imageWidth, frame.size.height / imageHeight);
+            transform.tx = frame.origin.x;
+            transform.ty = frame.origin.y;
+            overlay = [overlay imageByApplyingTransform:transform];
+            overlay = ApplyRegionAlpha(overlay, region.alpha);
+            result = [overlay imageByCompositingOverImage:result];
+        }
+
+        CGColorSpaceRef colorSpace = CVImageBufferGetColorSpace(pixelBuffer);
+        @try {
+            [_context render:result
+             toCVPixelBuffer:composited
+                      bounds:outputBounds
+                  colorSpace:colorSpace];
+        } @catch (NSException *exception) {
+            if (attachments != NULL)
+                CFRelease(attachments);
+            CVPixelBufferRelease(composited);
+            return NULL;
+        }
+        if (attachments != NULL) {
+            /* Core Image may derive output colour attachments from its render
+             * colour space. The sample must retain the decoder's authoritative
+             * mastering, transfer, matrix, aperture, and aspect metadata. */
+            CVBufferRemoveAllAttachments(composited);
+            CVBufferSetAttachments(composited, attachments,
+                                   kCVAttachmentMode_ShouldPropagate);
+            CFRelease(attachments);
+        }
+        return composited;
+    }
+}
+
+@end
