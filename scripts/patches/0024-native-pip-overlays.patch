+                                              overBuffer:retainedPixelBuffer
+                                              videoFrame:videoFrame
+                                           displayHeight:displayHeight];
+            if (warmed != NULL)
+                CVPixelBufferRelease(warmed);
+            CVPixelBufferRelease(retainedPixelBuffer);
+        }
+    });
+}
