+ * (at your option) any later version.
+ ******************************************************************************/
+
+#ifndef VLC_SAMPLEBUFFER_OVERLAY_GEOMETRY_H
+#define VLC_SAMPLEBUFFER_OVERLAY_GEOMETRY_H 1
+
+#include <CoreGraphics/CoreGraphics.h>
+#include <math.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+static inline bool vlc_samplebuffer_overlay_rect_is_finite(CGRect rect)
+{
+    return isfinite(rect.origin.x) && isfinite(rect.origin.y) &&
+        isfinite(rect.size.width) && isfinite(rect.size.height);
+}
+
+/* VLC region frames and vout placement use bottom-left backing coordinates,
+ * while vout place itself is stored from the display's top edge. Map a region
+ * to the decoded buffer without reinterpreting source aspect or orientation. */
+static inline bool vlc_samplebuffer_map_overlay_region(
+    CGRect region, CGRect video_frame, CGFloat display_height,
+    size_t pixel_width, size_t pixel_height, CGRect *mapped_region)
+{
+    if (mapped_region == NULL || pixel_width == 0 || pixel_height == 0 ||
+        !isfinite(display_height) || display_height <= 0.0 ||
+        !vlc_samplebuffer_overlay_rect_is_finite(region) ||
+        !vlc_samplebuffer_overlay_rect_is_finite(video_frame) ||
+        CGRectIsEmpty(region) || CGRectIsEmpty(video_frame))
+        return false;
+
+    CGFloat video_bottom = display_height - CGRectGetMaxY(video_frame);
+    CGRect backing_video_frame =
+        CGRectMake(video_frame.origin.x, video_bottom,
+                   video_frame.size.width, video_frame.size.height);
+    CGFloat scale_x = (CGFloat)pixel_width / backing_video_frame.size.width;
+    CGFloat scale_y = (CGFloat)pixel_height / backing_video_frame.size.height;
+    CGRect mapped = CGRectMake(
+        (CGRectGetMinX(region) - CGRectGetMinX(backing_video_frame)) * scale_x,
+        (CGRectGetMinY(region) - CGRectGetMinY(backing_video_frame)) * scale_y,
+        region.size.width * scale_x, region.size.height * scale_y);
+    CGRect output_bounds = CGRectMake(0, 0, pixel_width, pixel_height);
+    if (CGRectIsEmpty(CGRectIntersection(mapped, output_bounds)))
+        return false;
+
+    *mapped_region = mapped;
+    return true;
+}
+
+#endif
