+- (void)pictureInPictureOverlayCompositionDidChange:(bool)enabled
+{
+    atomic_store_explicit(&overlayCompositionEnabled, enabled,
+                          memory_order_release);
+    VLCSampleBufferSubpicture *snapshot;
+    @synchronized(_subpictureLock) {
+        snapshot = _subpicture;
+    }
+    [self refreshOverlayCompositionEnabled:enabled snapshot:snapshot];
+}
+
+- (void)refreshOverlayCompositionEnabled:(bool)enabled
+                                    snapshot:
+                                        (VLCSampleBufferSubpicture *)snapshot
+{
+    VLCSampleBufferDisplay *sys = self;
+    uint64_t refreshGeneration = atomic_fetch_add_explicit(
+        &overlayRefreshGeneration, 1, memory_order_acq_rel) + 1;
+
+    dispatch_block_t updateInlineOverlay = ^{
+        if (atomic_load_explicit(&sys->overlayRefreshGeneration,
+                                 memory_order_acquire) != refreshGeneration)
+            return;
+        @synchronized(sys.displayLayerLock) {
+            if (sys.displayClosed)
+                return;
+        }
+        VLCSampleBufferSubpicture *inlineSnapshot = nil;
+        if (!enabled) {
+            @synchronized(sys.subpictureLock) {
+                inlineSnapshot = sys.subpicture;
+            }
+        }
+        [sys.spuView drawSubpicture:inlineSnapshot];
+    };
+    dispatch_block_t scheduleInlineOverlayUpdate = ^{
+        if ([NSThread isMainThread])
+            updateInlineOverlay();
+        else
+            dispatch_async(dispatch_get_main_queue(), updateInlineOverlay);
+    };
+    /* Hide the sibling before the first burned-in frame can arrive. During
+     * restoration, keep it hidden until an uncomposited frame is enqueued so
+     * the inline surface never displays the same subtitle twice. */
+    if (enabled)
+        scheduleInlineOverlayUpdate();
+
+    CVPixelBufferRef basePixelBuffer = NULL;
+    CMSampleTimingInfo sampleTiming;
+    uint64_t frameSequence = 0;
+    CGRect videoFrame = CGRectZero;
+    CGFloat displayHeight = 0.0;
+    @synchronized(_displayLayerLock) {
+        if (!_displayClosed && latestUncompositedPixelBuffer != NULL) {
+            basePixelBuffer =
+                CVPixelBufferRetain(latestUncompositedPixelBuffer);
+            sampleTiming = latestSampleTiming;
+            frameSequence = latestFrameSequence;
+            videoFrame = CGRectMake(_vd->place->x, _vd->place->y,
+                                    _vd->place->width, _vd->place->height);
+            displayHeight = _vd->cfg->display.height;
+        }
+    }
+    if (basePixelBuffer == NULL) {
+        if (!enabled)
+            scheduleInlineOverlayUpdate();
+        return;
+    }
+
+    dispatch_async(_overlayRefreshQueue, ^{
+        if (atomic_load_explicit(&sys->overlayRefreshGeneration,
+                                 memory_order_acquire) != refreshGeneration) {
+            CVPixelBufferRelease(basePixelBuffer);
+            return;
+        }
+
+        CVPixelBufferRef refreshPixelBuffer = basePixelBuffer;
+        if (enabled && snapshot.regions.count != 0) {
+            VLCSampleBufferOverlayCompositor *compositor;
+            @synchronized(sys) {
+                if (sys.overlayCompositor == nil)
+                    sys.overlayCompositor =
+                        [VLCSampleBufferOverlayCompositor new];
+                compositor = sys.overlayCompositor;
+            }
+            CVPixelBufferRef composited;
+            @autoreleasepool {
+                composited =
+                    [compositor copyPixelBufferByCompositing:snapshot
+                                                  overBuffer:basePixelBuffer
+                                                  videoFrame:videoFrame
+                                               displayHeight:displayHeight];
+            }
+            if (composited == NULL) {
+                CVPixelBufferRelease(basePixelBuffer);
+                return;
+            }
+            refreshPixelBuffer = composited;
+        } else {
+            CVPixelBufferRetain(refreshPixelBuffer);
+        }
+
+        CMVideoFormatDescriptionRef formatDescription = NULL;
+        OSStatus status = CMVideoFormatDescriptionCreateForImageBuffer(
+            kCFAllocatorDefault, refreshPixelBuffer, &formatDescription);
+        CMSampleBufferRef sampleBuffer = NULL;
+        if (status == noErr) {
+            status = CMSampleBufferCreateReadyWithImageBuffer(
+                kCFAllocatorDefault, refreshPixelBuffer, formatDescription,
+                &sampleTiming, &sampleBuffer);
+            CFRelease(formatDescription);
+        }
+        CVPixelBufferRelease(refreshPixelBuffer);
+        CVPixelBufferRelease(basePixelBuffer);
+        if (status != noErr || sampleBuffer == NULL) {
+            if (!enabled)
+                scheduleInlineOverlayUpdate();
+            return;
+        }
+
+        CFArrayRef attachments =
+            CMSampleBufferGetSampleAttachmentsArray(sampleBuffer, true);
+        if (attachments != NULL && CFArrayGetCount(attachments) != 0) {
+            CFMutableDictionaryRef attachment =
+                (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0);
+            CFDictionarySetValue(attachment,
+                                 kCMSampleAttachmentKey_DisplayImmediately,
+                                 kCFBooleanTrue);
+        }
+
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (atomic_load_explicit(&sys->overlayRefreshGeneration,
+                                     memory_order_acquire) ==
+                refreshGeneration) {
+                @synchronized(sys.displayLayerLock) {
+                    if (!sys.displayClosed &&
+                        sys->latestFrameSequence == frameSequence &&
+                        sys.displayLayer != nil) {
+                        AVSampleBufferVideoRenderer *renderer =
+                            sys.displayLayer.sampleBufferRenderer;
+                        if (renderer.requiresFlushToResumeDecoding ||
+                            renderer.status ==
+                                AVQueuedSampleBufferRenderingStatusFailed)
+                            [renderer flush];
+                        /* This one bounded transition sample makes paused PiP
+                         * entry and inline restoration reflect the new
+                         * composition mode without waiting for another frame. */
+                        [renderer enqueueSampleBuffer:sampleBuffer];
+                    }
+                }
+                if (!enabled)
+                    updateInlineOverlay();
+            }
+            CFRelease(sampleBuffer);
+        });
+    });
+}
+
+- (void)prewarmOverlayForPixelBuffer:(CVPixelBufferRef)pixelBuffer
+                            snapshot:
+                                (VLCSampleBufferSubpicture *)snapshot
+                          videoFrame:(CGRect)videoFrame
+                       displayHeight:(CGFloat)displayHeight
+{
+    if (snapshot.regions.count == 0)
+        return;
+
+    OSType format = CVPixelBufferGetPixelFormatType(pixelBuffer);
+    size_t width = CVPixelBufferGetWidth(pixelBuffer);
+    size_t height = CVPixelBufferGetHeight(pixelBuffer);
+    CGColorSpaceRef colorSpace = CVImageBufferGetColorSpace(pixelBuffer);
+    uint64_t signature = 1469598103934665603ULL;
+#define MIX_OVERLAY_SIGNATURE(value) \
+    signature = (signature ^ (uint64_t)(value)) * 1099511628211ULL
+    MIX_OVERLAY_SIGNATURE(format);
+    MIX_OVERLAY_SIGNATURE(width);
+    MIX_OVERLAY_SIGNATURE(height);
+    MIX_OVERLAY_SIGNATURE(colorSpace != NULL ? CFHash(colorSpace) : 0);
+#undef MIX_OVERLAY_SIGNATURE
+
+    if (atomic_load_explicit(&lastOverlayWarmupSignature,
+                             memory_order_acquire) == signature)
+        return;
+
+    @synchronized(self) {
+        for (uint8_t index = 0; index < overlayWarmupSignatureCount; ++index) {
+            if (overlayWarmupSignatures[index] == signature) {
+                atomic_store_explicit(&lastOverlayWarmupSignature, signature,
+                                      memory_order_release);
+                return;
+            }
+        }
+        _Static_assert(ARRAY_SIZE(overlayWarmupSignatures) <= UINT8_MAX,
+                       "Warmup signature count exceeds its index type");
+        if (overlayWarmupSignatureCount <
+            (uint8_t)ARRAY_SIZE(overlayWarmupSignatures))
+            overlayWarmupSignatures[overlayWarmupSignatureCount++] = signature;
+        else {
+            overlayWarmupSignatures[overlayWarmupSignatureCursor] = signature;
+            overlayWarmupSignatureCursor =
+                (uint8_t)((overlayWarmupSignatureCursor + 1) %
+                          ARRAY_SIZE(overlayWarmupSignatures));
+        }
+        atomic_store_explicit(&lastOverlayWarmupSignature, signature,
+                              memory_order_release);
+    }
+
+    VLCSampleBufferDisplay *sys = self;
+    CVPixelBufferRef retainedPixelBuffer = CVPixelBufferRetain(pixelBuffer);
+    dispatch_async(_overlayRefreshQueue, ^{
+        @autoreleasepool {
+            VLCSampleBufferOverlayCompositor *compositor;
+            @synchronized(sys) {
+                if (sys.overlayCompositor == nil)
