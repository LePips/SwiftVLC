+static bool
+libvlc_media_player_AppleAudioSessionIsApplicationManaged(
+    libvlc_media_player_t *p_mi)
+{
+    char *management = var_InheritString(p_mi,
+                                         "apple-audio-session-management");
+    bool application_managed = management != NULL
+                            && strcmp(management, "application") == 0;
+    free(management);
+    return application_managed;
+}
+
+int
+swiftvlc_libvlc_media_player_acquire_apple_audio_session_lease(
+    libvlc_media_player_t *p_mi,
+    swiftvlc_apple_audio_session_lease_t *lease)
+{
+    if (lease == NULL)
+        return swiftvlc_apple_audio_session_lease_failed;
+    *lease = 0;
+    if (p_mi == NULL)
+        return swiftvlc_apple_audio_session_lease_failed;
+    if (libvlc_media_player_AppleAudioSessionIsApplicationManaged(p_mi))
+        return swiftvlc_apple_audio_session_lease_application_managed;
+#ifdef __APPLE__
+    return vlc_apple_audio_session_acquire_lease(p_mi, lease) == VLC_SUCCESS
+         ? swiftvlc_apple_audio_session_lease_acquired
+         : swiftvlc_apple_audio_session_lease_failed;
+#else
+    return swiftvlc_apple_audio_session_lease_failed;
+#endif
+}
+
+bool
+swiftvlc_libvlc_media_player_release_apple_audio_session_lease(
+    libvlc_media_player_t *p_mi,
+    swiftvlc_apple_audio_session_lease_t lease)
+{
+    if (p_mi == NULL || lease == 0)
+        return false;
+#ifdef __APPLE__
+    return vlc_apple_audio_session_release_lease(p_mi, lease);
+#else
+    return false;
+#endif
+}
