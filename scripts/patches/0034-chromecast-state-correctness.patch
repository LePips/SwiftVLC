+/*****************************************************************************
+ * chromecast_demux_eof.hpp: fail-closed Chromecast drain classification
+ *****************************************************************************/
+
+#ifndef VLC_CHROMECAST_DEMUX_EOF_HPP
+#define VLC_CHROMECAST_DEMUX_EOF_HPP
+
+#include <vlc_common.h>
+
+/* ES_OUT_DRAIN and ES_OUT_IS_EMPTY are fallible controls. A failed control
+ * says nothing about emptiness, so it must never be translated into EOF. */
+template <typename Drain, typename IsEmpty>
+static inline bool chromecast_demux_drained_and_empty(Drain &&drain,
+                                                       IsEmpty &&is_empty)
+{
+    if (drain() != VLC_SUCCESS)
+        return false;
+
+    bool empty = false;
+    return is_empty(&empty) == VLC_SUCCESS && empty;
+}
+
+#endif
