+
+void intf_sys_t::clearMediaSessionState()
+{
+    m_requests.clear();
+    m_pauseRetriesLeft = 1;
+    m_stopRetriesLeft = 1;
+    m_statusRetriesLeft = 1;
+    m_progressWatchdog.clear();
+    m_mediaSessionId = 0;
+    m_request_stop = false;
+    m_cc_time_last_request_date = VLC_TICK_INVALID;
+    m_cc_clock.clear();
+}
+
+bool intf_sys_t::recordMediaRequest(chromecast_media_command command,
+                                    unsigned request_id)
+{
+    const int timeout_ms = command == chromecast_media_command::Load
+        ? MEDIA_LOAD_TIMEOUT_MS : MEDIA_COMMAND_TIMEOUT_MS;
+    return m_requests.record(command, request_id,
+        chromecast_deadline(vlc_tick_now(), timeout_ms));
+}
+
+void intf_sys_t::armStateDeadline(States state)
+{
+    int timeout_ms = 0;
+    switch (state)
+    {
+        case Authenticating:
+        case Connecting:
+        case Launching:
+            timeout_ms = CONTROL_STATE_TIMEOUT_MS;
+            break;
+        default:
+            break;
+    }
+    m_stateDeadline = timeout_ms == 0 ? VLC_TICK_INVALID
+        : chromecast_deadline(vlc_tick_now(), timeout_ms);
+}
+
+void intf_sys_t::updateProgressWatchdog(States state)
+{
+    if (state == Loading || state == Buffering)
+        m_progressWatchdog.arm(vlc_tick_now(), MEDIA_PROGRESS_TIMEOUT_MS);
+    else
+        m_progressWatchdog.clear();
+}
+
+int intf_sys_t::nextMessageWaitTimeout(vlc_tick_t now,
+                                       bool *heartbeat_timeout) const
+{
+    vlc_tick_t deadline = m_stateDeadline;
+    const vlc_tick_t request_deadline = m_requests.next_deadline();
+    if (deadline == VLC_TICK_INVALID
+     || (request_deadline != VLC_TICK_INVALID
+      && request_deadline < deadline))
+        deadline = request_deadline;
+    const vlc_tick_t progress_deadline = m_progressWatchdog.deadline();
+    if (deadline == VLC_TICK_INVALID
+     || (progress_deadline != VLC_TICK_INVALID
+      && progress_deadline < deadline))
+        deadline = progress_deadline;
+
+    *heartbeat_timeout = true;
+    if (deadline == VLC_TICK_INVALID)
+        return PING_WAIT_TIME_MS;
+
+    if (now >= deadline)
+    {
+        *heartbeat_timeout = false;
+        return 0;
+    }
+
+    int64_t remaining_ms = MS_FROM_VLC_TICK(deadline - now);
+    if (remaining_ms <= 0)
+        remaining_ms = 1;
+    if (remaining_ms <= PING_WAIT_TIME_MS)
+    {
+        *heartbeat_timeout = false;
+        return static_cast<int>(remaining_ms);
+    }
+    return PING_WAIT_TIME_MS;
+}
+
+bool intf_sys_t::checkCommandAndStateDeadlines(vlc_tick_t now)
+{
+    if (m_requests.expired(chromecast_media_command::Load, now))
+    {
+        msg_Err(m_module, "Chromecast LOAD response timed out");
+        clearMediaSessionState();
+        setState(LoadFailed);
+    }
+
+    const bool play_expired =
+        m_requests.expired(chromecast_media_command::Play, now);
+    const bool pause_expired =
+        m_requests.expired(chromecast_media_command::Pause, now);
+    if (play_expired || pause_expired)
+    {
+        if (play_expired)
+            m_requests.discard(chromecast_media_command::Play);
+        if (pause_expired)
+            m_requests.discard(chromecast_media_command::Pause);
+
+        const bool observed_paused = m_state == Paused;
+        if (observed_paused == m_desired_paused)
+            m_pauseRetriesLeft = 1;
+        else
+        {
+            const chromecast_media_command desired_command = m_desired_paused
+                ? chromecast_media_command::Pause
+                : chromecast_media_command::Play;
+            if (!m_requests.pending(desired_command))
+            {
+                if (m_pauseRetriesLeft == 0)
+                {
+                    msg_Err(m_module,
+                            "Chromecast pause/play response timed out");
+                    setConnectionDead();
+                    return false;
+                }
+                --m_pauseRetriesLeft;
+                if (!sendDesiredPauseState())
+                {
+                    setConnectionDead();
+                    return false;
+                }
+            }
+        }
+    }
+
+    if (m_requests.expired(chromecast_media_command::Stop, now))
+    {
+        m_requests.discard(chromecast_media_command::Stop);
+        if (m_stopRetriesLeft == 0 || m_mediaSessionId == 0
+         || !m_request_stop)
+        {
+            msg_Err(m_module, "Chromecast STOP response timed out");
+            setConnectionDead();
+            return false;
+        }
+        --m_stopRetriesLeft;
