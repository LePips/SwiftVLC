+/* Google Cast's media namespace is carried by a transport message whose
+ * complete protobuf envelope is limited to 64 KiB. Keep one shared limit for
+ * both the receive and send paths; accepting a larger inbound frame while
+ * refusing it outbound would leave the stream desynchronised. */
+static constexpr size_t CHROMECAST_MESSAGE_MAX_SIZE = 64u * 1024u;
+static constexpr int CHROMECAST_WRITE_TIMEOUT_MS = 2000;
+
+enum class chromecast_media_command
+{
+    None,
+    Load,
+    Play,
+    Pause,
+    Stop,
+    Status,
+};
+
+/* MEDIA_STATUS is both a broadcast (requestId 0) and the acknowledgement for
+ * several independent commands. A single shared request ID makes one reply
+ * erase attribution for every other in-flight command. This fixed tracker
+ * deliberately keeps one latest generation per command instead. */
+class chromecast_media_request_tracker
+{
+    struct request
+    {
+        unsigned id = 0;
+        vlc_tick_t deadline = VLC_TICK_INVALID;
+    };
+
+public:
+    void clear()
+    {
+        m_load = m_play = m_pause = m_stop = m_status = {};
+    }
+
+    bool record(chromecast_media_command command, unsigned request_id,
+                vlc_tick_t deadline)
+    {
+        if (command == chromecast_media_command::None || request_id == 0
+         || deadline == VLC_TICK_INVALID)
+            return false;
+        request &target = slot(command);
+        if (target.id != 0)
+            return false;
+        const chromecast_media_command collision = match(request_id);
+        if (collision != chromecast_media_command::None)
+            return false;
+        target = { request_id, deadline };
+        return true;
+    }
+
+    chromecast_media_command match(unsigned request_id) const
+    {
+        if (request_id == 0)
+            return chromecast_media_command::None;
+        if (request_id == m_load.id)
+            return chromecast_media_command::Load;
+        if (request_id == m_play.id)
+            return chromecast_media_command::Play;
+        if (request_id == m_pause.id)
+            return chromecast_media_command::Pause;
+        if (request_id == m_stop.id)
+            return chromecast_media_command::Stop;
+        if (request_id == m_status.id)
+            return chromecast_media_command::Status;
+        return chromecast_media_command::None;
+    }
+
+    chromecast_media_command acknowledge(unsigned request_id)
+    {
+        const chromecast_media_command command = match(request_id);
+        if (command != chromecast_media_command::None)
+            slot(command) = {};
+        return command;
+    }
+
+    bool pending(chromecast_media_command command) const
+    {
+        return value(command).id != 0;
+    }
+
+    bool expired(chromecast_media_command command, vlc_tick_t now) const
+    {
+        const request &value = this->value(command);
+        return value.id != 0 && now >= value.deadline;
+    }
+
+    vlc_tick_t next_deadline() const
+    {
+        vlc_tick_t deadline = VLC_TICK_INVALID;
+        const request *const requests[] = {
+            &m_load, &m_play, &m_pause, &m_stop, &m_status,
+        };
+        for (const request *candidate : requests)
+        {
+            if (candidate->id == 0)
+                continue;
+            if (deadline == VLC_TICK_INVALID
+             || candidate->deadline < deadline)
+                deadline = candidate->deadline;
+        }
+        return deadline;
+    }
+
+    void discard(chromecast_media_command command)
+    {
+        if (command != chromecast_media_command::None)
+            slot(command) = {};
+    }
+
+private:
+    request &slot(chromecast_media_command command)
+    {
+        switch (command)
+        {
+            case chromecast_media_command::Load: return m_load;
+            case chromecast_media_command::Play: return m_play;
+            case chromecast_media_command::Pause: return m_pause;
+            case chromecast_media_command::Stop: return m_stop;
+            case chromecast_media_command::Status: return m_status;
+            case chromecast_media_command::None: break;
+        }
+        vlc_assert_unreachable();
+    }
+
+    const request &value(chromecast_media_command command) const
+    {
+        switch (command)
+        {
+            case chromecast_media_command::Load: return m_load;
+            case chromecast_media_command::Play: return m_play;
+            case chromecast_media_command::Pause: return m_pause;
+            case chromecast_media_command::Stop: return m_stop;
+            case chromecast_media_command::Status: return m_status;
+            case chromecast_media_command::None: break;
+        }
+        vlc_assert_unreachable();
+    }
+
+    request m_load;
+    request m_play;
+    request m_pause;
+    request m_stop;
+    request m_status;
+};
+
+static inline vlc_tick_t
+chromecast_deadline(vlc_tick_t now, int timeout_ms)
+{
+    if (timeout_ms <= 0)
+        return now;
+    const vlc_tick_t timeout = VLC_TICK_FROM_MS(timeout_ms);
+    return now > VLC_TICK_MAX - timeout ? VLC_TICK_MAX : now + timeout;
+}
+
+/* Loading and buffering are one continuous lack-of-progress interval. The
+ * receiver can alternate those states, so arming must be idempotent until a
+ * playable/paused/terminal state explicitly clears the watchdog. */
+class chromecast_progress_watchdog
+{
+public:
+    void clear()
+    {
+        m_deadline = VLC_TICK_INVALID;
+    }
+
+    void arm(vlc_tick_t now, int timeout_ms)
+    {
+        if (m_deadline == VLC_TICK_INVALID)
+            m_deadline = chromecast_deadline(now, timeout_ms);
+    }
+
+    bool expired(vlc_tick_t now) const
+    {
+        return m_deadline != VLC_TICK_INVALID && now >= m_deadline;
+    }
+
+    vlc_tick_t deadline() const
+    {
+        return m_deadline;
+    }
+
+private:
+    vlc_tick_t m_deadline = VLC_TICK_INVALID;
+};
+
+static inline bool
+chromecast_request_id_value(double value, unsigned *result)
+{
+    if (!std::isfinite(value) || value < 0
+     || value > std::numeric_limits<unsigned>::max()
+     || std::floor(value) != value)
+        return false;
+    *result = static_cast<unsigned>(value);
+    return true;
+}
+
+static inline bool
+chromecast_json_request_id(const struct json_object *object, unsigned *result)
+{
+    return chromecast_request_id_value(json_get_num(object, "requestId"),
+                                       result);
+}
+
+static inline bool
+chromecast_media_session_id_value(double value, int64_t *result)
+{
+    if (!std::isfinite(value) || value <= 0
+     || value >= std::ldexp(1.0, 63)
+     || std::floor(value) != value)
+        return false;
+    *result = static_cast<int64_t>(value);
+    return true;
+}
+
+static inline bool
+chromecast_json_media_session_id(const struct json_object *object,
+                                 int64_t *result)
+{
+    return chromecast_media_session_id_value(
+        json_get_num(object, "mediaSessionId"), result);
+}
+
+/* Receiver time is sampled, never invented. currentTime and playbackRate
+ * must be finite and non-negative before conversion. Only PLAYING advances
+ * the sampled clock; PAUSED and BUFFERING freeze at the receiver's reported
+ * position even when buggy firmware leaves playbackRate at 1. */
+class chromecast_media_clock
+{
+public:
+    bool valid() const
+    {
+        return m_valid;
+    }
+
+    void clear()
+    {
+        m_valid = false;
+        m_media_time = 0;
+        m_sample_date = 0;
+        m_rate = 0.;
+    }
+
+    bool update(double current_time, double playback_rate,
+                std::string_view player_state, vlc_tick_t sample_date)
+    {
+        const long double ticks =
+            static_cast<long double>(current_time) * CLOCK_FREQ;
+        if (!std::isfinite(current_time) || current_time < 0
+         || !std::isfinite(playback_rate) || playback_rate < 0
+         || ticks > static_cast<long double>(VLC_TICK_MAX))
+            return false;
+
+        m_media_time = static_cast<vlc_tick_t>(ticks);
+        m_sample_date = sample_date;
+        m_rate = player_state == "PLAYING" ? playback_rate : 0.;
+        m_valid = true;
+        return true;
+    }
+
+    vlc_tick_t get(vlc_tick_t now) const
+    {
+        if (!m_valid)
+            return VLC_TICK_INVALID;
+        if (now <= m_sample_date || m_rate == 0.)
+            return m_media_time == VLC_TICK_INVALID ? VLC_TICK_0
+                                                    : m_media_time;
+
+        const long double value = static_cast<long double>(m_media_time)
+            + static_cast<long double>(now - m_sample_date) * m_rate;
+        if (value > static_cast<long double>(VLC_TICK_MAX))
+            return VLC_TICK_INVALID;
+        const vlc_tick_t result = static_cast<vlc_tick_t>(value);
+        /* The pinned VLC uses zero as its invalid tick sentinel. Preserve a
+         * valid receiver currentTime of exactly zero with VLC_TICK_0 (one
+         * tick) rather than making the sample indistinguishable from unset. */
+        return result == VLC_TICK_INVALID ? VLC_TICK_0 : result;
+    }
+
+private:
+    bool m_valid = false;
+    vlc_tick_t m_media_time = 0;
+    vlc_tick_t m_sample_date = 0;
+    double m_rate = 0.;
+};
+
+static inline int
+chromecast_remaining_timeout_ms(vlc_tick_t begin, vlc_tick_t now,
+                                int timeout_ms)
+{
+    if (timeout_ms <= 0)
+        return 0;
+    if (now <= begin)
+        return timeout_ms;
+    const int64_t elapsed_ms = MS_FROM_VLC_TICK(now - begin);
+    return elapsed_ms >= timeout_ms ? 0
+                                    : timeout_ms - static_cast<int>(elapsed_ms);
+}
+
+/* vlc_tls_Write() waits for POLLOUT with an infinite timeout in the pinned
+ * VLC. Cast control sends need the same finite total-budget semantics as
+ * receives: partial progress, EAGAIN, EINTR, and spurious readiness must all
+ * remain inside one deadline. The callbacks keep this policy directly
+ * executable without a network or a receiver. */
+template <typename Write, typename Wait, typename Now>
+static inline bool
+chromecast_write_all_bounded(size_t size, int timeout_ms, Write &&write,
+                             Wait &&wait, Now &&now)
+{
+    if (size == 0 || timeout_ms <= 0)
+    {
+        errno = EINVAL;
+        return false;
+    }
+
+    const vlc_tick_t begin = now();
+    size_t sent = 0;
+    bool attempted = false;
+    while (sent < size)
+    {
+        if (attempted
+         && chromecast_remaining_timeout_ms(begin, now(), timeout_ms) == 0)
+        {
+            errno = ETIMEDOUT;
+            return false;
+        }
+
+        attempted = true;
+        const ssize_t value = write(sent, size - sent);
+        if (value > 0)
+        {
+            if (static_cast<size_t>(value) > size - sent)
+            {
+                errno = EPROTO;
+                return false;
+            }
+            sent += static_cast<size_t>(value);
+            continue;
+        }
+        if (value == 0)
+        {
+            errno = EPIPE;
+            return false;
+        }
+        if (errno != EAGAIN && errno != EINTR)
+            return false;
+
+        const int remaining = chromecast_remaining_timeout_ms(
+            begin, now(), timeout_ms);
+        if (remaining == 0)
+        {
+            errno = ETIMEDOUT;
+            return false;
+        }
+        const int ready = wait(remaining);
+        if (ready <= 0)
+        {
+            if (ready == 0)
+                errno = ETIMEDOUT;
+            return false;
+        }
+    }
+    return true;
+}
