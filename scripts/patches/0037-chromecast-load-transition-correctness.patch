+static inline std::string
+chromecast_stream_query(uint64_t stream_token)
+{
+    if (stream_token == 0)
+        return {};
+    return "streamToken=" + std::to_string(stream_token);
+}
+
+static inline bool
+chromecast_stream_query_matches(std::string_view query,
+                                uint64_t expected_stream_token)
+{
+    static constexpr std::string_view prefix = "streamToken=";
+    if (expected_stream_token == 0 || query.size() <= prefix.size()
+     || query.compare(0, prefix.size(), prefix) != 0)
+        return false;
+
+    const std::string_view value = query.substr(prefix.size());
+    if (value.size() > 1 && value.front() == '0')
+        return false;
+
+    uint64_t parsed = 0;
+    for (const char c : value)
+    {
+        if (c < '0' || c > '9')
+            return false;
+        const uint64_t digit = static_cast<uint64_t>(c - '0');
+        if (parsed > (std::numeric_limits<uint64_t>::max() - digit) / 10)
+            return false;
+        parsed = parsed * 10 + digit;
+    }
+    return parsed == expected_stream_token;
+}
+
+static inline std::string
+chromecast_stream_url(const std::string &base_url, const std::string &path,
+                      uint64_t stream_token)
+{
+    const std::string query = chromecast_stream_query(stream_token);
+    if (base_url.empty() || path.empty() || query.empty())
+        return {};
+    return base_url + path + "?" + query;
+}
