+    assert(!sys->dummy);
+    assert(request_frame_count > 0);
+    assert(observer_request_id != 0 && observer_generation != 0);
+    assert(claim_commit != NULL && displayed != NULL && standard != NULL
+        && needs_pictures != NULL);
+
+    vout_control_Hold(&sys->control);
+    if (sys->strict_frame.observer_request_id != 0
+     || sys->strict_frame.target_request_id != 0
+     || sys->strict_frame.committed_request_id != 0)
+    {
+        vout_control_Release(&sys->control);
+        return -EBUSY;
+    }
+    if (unlikely(request_frame_count >= SIZE_MAX - sys->frame_next_count))
+    {
