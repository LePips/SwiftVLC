+void vout_CancelNextPictureObserver(
+    vout_thread_t *vout, uint64_t strict_request_id,
+    uint64_t strict_generation,
+    struct vout_frame_next_cancel_result *result)
+{
+    vout_thread_sys_t *sys = VOUT_THREAD_TO_SYS(vout);
+    assert(!sys->dummy);
+    assert(result != NULL);
+
+    *result = (struct vout_frame_next_cancel_result) { 0 };
+    vout_control_Hold(&sys->control);
+
+    if (sys->strict_frame.observer_request_id == 0)
+    {
+        vout_control_Release(&sys->control);
+        return;
+    }
+
+    if (sys->strict_frame.target_request_id != 0)
+    {
+        const bool matches = strict_request_id == 0
+            || (sys->strict_frame.target_request_id == strict_request_id
+             && sys->strict_frame.target_generation == strict_generation);
+        assert(matches);
+        if (likely(matches))
+        {
+            assert(sys->strict_frame.countdown > 0);
+            const size_t before = sys->strict_frame.countdown - 1;
+            assert(sys->strict_frame.standard_skip_count <= before);
+            result->standard_before =
+                before - sys->strict_frame.standard_skip_count;
+            result->standard_after =
+                sys->frame_next_count - sys->strict_frame.countdown;
+            result->strict_removed = true;
+        }
+    }
+    else if (sys->strict_frame.committed_request_id != 0)
+    {
+        const bool matches = strict_request_id == 0
+            || (sys->strict_frame.committed_request_id == strict_request_id
+             && sys->strict_frame.committed_generation == strict_generation);
+        assert(matches);
+        if (likely(matches))
+        {
+            result->strict_committed = true;
+            result->standard_after = sys->frame_next_count;
+        }
+    }
+    else
+    {
+        assert(sys->strict_frame.standard_skip_count
+            <= sys->frame_next_count);
+        result->standard_before = sys->frame_next_count
+            - sys->strict_frame.standard_skip_count;
+    }
+
+    sys->frame_next_count = 0;
+    vout_ClearStrictFrame(sys);
+    vout_control_ReleaseAndWake(&sys->control);
+}
