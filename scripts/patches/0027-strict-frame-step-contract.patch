+int vout_NextPictureStrict(vout_thread_t *vout, size_t request_frame_count,
+                           size_t strict_ordinal,
+                           size_t unreported_prior_count,
+                           uint64_t request_id,
+                           uint64_t generation,
+                           vout_strict_frame_claim_commit_cb claim_commit,
+                           vout_strict_frame_displayed_cb displayed,
+                           vout_strict_frame_standard_cb standard,
+                           vout_strict_frame_needs_pictures_cb needs_pictures,
+                           void *opaque, size_t *needed_count,
+                           uint64_t *observer_request_id,
+                           uint64_t *observer_generation)
+{
+    vout_thread_sys_t *sys = VOUT_THREAD_TO_SYS(vout);
+    assert(!sys->dummy);
+    assert(request_frame_count > 0);
+    assert(strict_ordinal > 0 && strict_ordinal <= request_frame_count);
+    assert(request_id != 0 && generation != 0);
+    assert(claim_commit != NULL && displayed != NULL && standard != NULL
+        && needs_pictures != NULL
+        && needed_count != NULL && observer_request_id != NULL
+        && observer_generation != NULL);
+
+    vout_control_Hold(&sys->control);
+
+    if (sys->strict_frame.target_request_id != 0
+     || sys->strict_frame.committed_request_id != 0)
+    {
+        vout_control_Release(&sys->control);
+        return -EBUSY;
+    }
+
+    const size_t prior_count = sys->frame_next_count;
+    if (unlikely(request_frame_count >= SIZE_MAX - prior_count))
+    {
+        vout_control_Release(&sys->control);
+        return -EOVERFLOW;
+    }
+    sys->frame_next_count += request_frame_count;
+    sys->strict_frame.target_request_id = request_id;
+    sys->strict_frame.target_generation = generation;
+    sys->strict_frame.countdown = prior_count + strict_ordinal;
+    if (sys->strict_frame.observer_request_id == 0)
+    {
+        sys->strict_frame.observer_request_id = request_id;
+        sys->strict_frame.observer_generation = generation;
+        sys->strict_frame.claim_commit = claim_commit;
+        sys->strict_frame.displayed = displayed;
+        sys->strict_frame.standard = standard;
+        sys->strict_frame.needs_pictures = needs_pictures;
+        const size_t unreported_prior = __MIN(unreported_prior_count,
+                                              prior_count);
+        sys->strict_frame.standard_skip_count =
+            prior_count - unreported_prior;
+        sys->strict_frame.next_observation = 0;
+        sys->strict_frame.no_output_observation = 0;
+        sys->strict_frame.opaque = opaque;
+    }
+    else
+    {
+        /* Explicit cancellation removes only its strict member. The output
+         * observer continues to own independent legacy members and a later
+         * strict request can bind to that same ordered aggregate. */
+        assert(sys->strict_frame.claim_commit == claim_commit);
+        assert(sys->strict_frame.displayed == displayed);
+        assert(sys->strict_frame.standard == standard);
+        assert(sys->strict_frame.needs_pictures == needs_pictures);
+        assert(sys->strict_frame.opaque == opaque);
+    }
+
+    /* Static filters can turn one decoded picture into zero, one, or many
+     * final outputs. Let the vout exhaust pending/filter/raw output first;
+     * only an observed PreparePicture(NULL) edge may request one replacement
+     * decoded picture. */
+    *needed_count = 0;
+    *observer_request_id = sys->strict_frame.observer_request_id;
+    *observer_generation = sys->strict_frame.observer_generation;
+
+    vout_control_ReleaseAndWake(&sys->control);
+    return VLC_SUCCESS;
+}
+
+int vout_ReconcileNextPictureStrict(vout_thread_t *vout,
+                                    uint64_t request_id,
+                                    uint64_t generation,
+                                    uint64_t observation,
+                                    size_t *needed_count,
+                                    size_t *strict_ordinal,
+                                    size_t *standard_skip_count)
+{
+    vout_thread_sys_t *sys = VOUT_THREAD_TO_SYS(vout);
+    assert(!sys->dummy);
+    assert(request_id != 0 && generation != 0);
+    assert(needed_count != NULL && strict_ordinal != NULL
+        && standard_skip_count != NULL);
+
+    vout_control_Hold(&sys->control);
+    if (sys->strict_frame.observer_request_id != request_id
+     || sys->strict_frame.observer_generation != generation)
+    {
+        vout_control_Release(&sys->control);
+        return VLC_ENOENT;
+    }
+
+    /* The render callback is only a coalesced wake edge. Accept it solely if
+     * it still names the most recent serialized no-output observation. A
+     * later concrete/buffered output invalidates the observation instead of
+     * letting stale callback-time counts shift the strict ordinal. */
+    if (observation == 0
+     || sys->strict_frame.no_output_observation != observation)
+    {
+        vout_control_ReleaseAndWake(&sys->control);
+        return -EAGAIN;
+    }
+
+    picture_fifo_Lock(sys->decoder_fifo);
+    const bool raw_empty = picture_fifo_IsEmpty(sys->decoder_fifo);
+    picture_fifo_Unlock(sys->decoder_fifo);
+    if (!raw_empty)
+    {
+        sys->strict_frame.no_output_observation = 0;
+        vout_control_ReleaseAndWake(&sys->control);
+        return -EAGAIN;
+    }
+
+    assert((sys->strict_frame.target_request_id == 0)
+        == (sys->strict_frame.countdown == 0));
+    assert(sys->strict_frame.countdown <= sys->frame_next_count);
+    *needed_count = sys->frame_next_count;
+    *strict_ordinal = sys->strict_frame.countdown;
+    *standard_skip_count = sys->strict_frame.standard_skip_count;
+    assert(*strict_ordinal <= *needed_count);
+
+    /* Consume this proof once. The decoder requests at most one raw picture;
+     * the vout must produce a fresh no-output observation before another.
+     * Do not wake here: NEED_DATA=true still has to reach the input main loop,
+     * and replacement controls have higher priority. The eventual decoded
+     * vout_PutPicture is the only success-path wake source, which prevents a
+     * no-output/reconcile loop from starving demux forever. */
+    sys->strict_frame.no_output_observation = 0;
+    vout_control_Release(&sys->control);
+    return VLC_SUCCESS;
+}
+
+bool vout_WakeNextPictureStrict(vout_thread_t *vout, uint64_t request_id,
+                                uint64_t generation)
+{
+    vout_thread_sys_t *sys = VOUT_THREAD_TO_SYS(vout);
+    assert(!sys->dummy);
+
+    vout_control_Hold(&sys->control);
+    const bool matches = request_id != 0
+                      && sys->strict_frame.observer_request_id == request_id
+                      && sys->strict_frame.observer_generation == generation;
+    if (matches)
+        vout_control_ReleaseAndWake(&sys->control);
+    else
+        vout_control_Release(&sys->control);
+    return matches;
+}
+
+bool vout_CompleteNextPictureStrict(vout_thread_t *vout,
+                                    uint64_t request_id,
+                                    uint64_t generation)
+{
+    vout_thread_sys_t *sys = VOUT_THREAD_TO_SYS(vout);
+    assert(!sys->dummy);
+
+    vout_control_Hold(&sys->control);
+    const bool completed = request_id != 0
+                        && sys->strict_frame.committed_request_id == request_id
+                        && sys->strict_frame.committed_generation == generation;
+    if (completed)
+    {
+        sys->strict_frame.committed_request_id = 0;
+        sys->strict_frame.committed_generation = 0;
+        /* Do not clear an otherwise idle observer at strict acknowledgement.
+         * A legacy SET which was globally accepted after the strict SET can
+         * still be waiting in the ordinary input-control lane while the
+         * priority terminal is acknowledged here. Keeping the observer lets
+         * that later member use final-output accounting, including static
+         * filter pending output at EOF. The observer clears itself after its
+         * final concrete legacy attempt (wake observation zero), or at a
+         * causal reset/display teardown. It can also be rebound by the next
+         * strict generation without retaining public ownership of this one. */
+    }
+    const bool observer_remains = completed
+                               && sys->strict_frame.observer_request_id != 0;
+    vout_control_Release(&sys->control);
+    return observer_remains;
+}
+
+bool vout_CompleteNextPictureObserver(vout_thread_t *vout,
+                                      uint64_t request_id,
+                                      uint64_t generation)
+{
+    vout_thread_sys_t *sys = VOUT_THREAD_TO_SYS(vout);
+    assert(!sys->dummy);
+
+    vout_control_Hold(&sys->control);
+    const bool matches = request_id != 0
+                      && sys->strict_frame.observer_request_id == request_id
+                      && sys->strict_frame.observer_generation == generation;
+    if (matches && sys->frame_next_count == 0
+     && sys->strict_frame.target_request_id == 0
+     && sys->strict_frame.committed_request_id == 0)
+        vout_ClearStrictFrame(sys);
+    const bool observer_remains = matches
+                               && sys->strict_frame.observer_request_id != 0;
+    vout_control_Release(&sys->control);
+    return observer_remains;
+}
+
+bool vout_CancelNextPictureStrict(vout_thread_t *vout, uint64_t request_id,
+                                  uint64_t generation,
+                                  bool *observer_remains)
+{
+    vout_thread_sys_t *sys = VOUT_THREAD_TO_SYS(vout);
+    assert(!sys->dummy);
+    assert(observer_remains != NULL);
+    *observer_remains = false;
+
+    vout_control_Hold(&sys->control);
+    if (request_id == 0)
+    {
+        vout_control_Release(&sys->control);
+        return false;
+    }
+
+    if (sys->strict_frame.committed_request_id == request_id
+     && sys->strict_frame.committed_generation == generation)
+    {
+        /* The exact terminal is already committed. Acknowledge/detach only
+         * that marker; independent legacy members retain the observer. */
+        sys->strict_frame.committed_request_id = 0;
+        sys->strict_frame.committed_generation = 0;
+        *observer_remains = sys->strict_frame.observer_request_id != 0;
+        vout_control_ReleaseAndWake(&sys->control);
+        return false;
+    }
+
+    if (sys->strict_frame.target_request_id != request_id
+     || sys->strict_frame.target_generation != generation)
+    {
+        *observer_remains = sys->strict_frame.observer_request_id != 0
+                         && sys->frame_next_count != 0;
+        vout_control_Release(&sys->control);
+        return false;
+    }
+
+    /* Remove only the canceled strict member. Legacy prefix/tail members stay
+     * final-output-accounted and may bind a later strict target safely. */
+    assert(sys->frame_next_count > 0);
+    --sys->frame_next_count;
+    sys->strict_frame.target_request_id = 0;
+    sys->strict_frame.target_generation = 0;
+    sys->strict_frame.countdown = 0;
+    if (sys->frame_next_count == 0)
+        vout_ClearStrictFrame(sys);
+    *observer_remains = sys->strict_frame.observer_request_id != 0;
+
+    /* This runs on the globally ordered CANCEL control before a reused SET(B).
+     * Clear every module-side overlay/pending identity synchronously. The lock
+     * order control -> display is the existing vout_Flush order. */
+    vlc_queuedmutex_lock(&sys->display_lock);
+    if (sys->display != NULL)
+        vout_display_PurgePictureSubmissions(sys->display, false);
+    vlc_queuedmutex_unlock(&sys->display_lock);
+    vout_control_ReleaseAndWake(&sys->control);
+    return true;
+}
