+    const uint64_t count = sys->frame_next_terminal_origin_count;
+    vlc_mutex_unlock(&sys->lock_control);
+    return count;
+}
+
+int input_ControlPushStrictFrame(input_thread_t *input, int type,
+                                 const input_control_param_t *param)
+{
+    assert(type == INPUT_CONTROL_SET_FRAME_NEXT
+        || type == INPUT_CONTROL_CANCEL_FRAME_NEXT);
+    assert(param != NULL && param->frame_next.request_id != 0
+        && param->frame_next.generation != 0);
+
+    input_thread_private_t *sys = input_priv(input);
+    vlc_mutex_lock(&sys->lock_control);
+
+    if (type == INPUT_CONTROL_CANCEL_FRAME_NEXT
+     && ((sys->strict_frame_active_request_id
+                == param->frame_next.request_id
+       && sys->strict_frame_active_generation
+                == param->frame_next.generation
+       && sys->strict_frame_commit_claimed)
+      || FrameNextTerminalContainsStrictLocked(
+             sys, param->frame_next.request_id,
+             param->frame_next.generation)))
+    {
+        /* Commit remains authoritative even after input_Stop() and while its
+         * terminal is queued, in transit to the player, or occupying the
+         * allocation-free overflow slot. Detached STOPPING can therefore
+         * carry the prior winner instead of re-arbitrating it as canceled. */
+        vlc_mutex_unlock(&sys->lock_control);
+        return -EALREADY;
+    }
+
+    if (sys->is_stopped)
+    {
+        vlc_mutex_unlock(&sys->lock_control);
+        /* Teardown is itself the downstream cancellation guarantee. */
+        return type == INPUT_CONTROL_CANCEL_FRAME_NEXT
+             ? VLC_SUCCESS : VLC_EGENERIC;
+    }
+
+    if (type == INPUT_CONTROL_SET_FRAME_NEXT)
+    {
+        if (sys->frame_next_natural_eof_quiescing)
+        {
+            /* MainLoop has crossed the natural-EOF boundary and can no longer
+             * consume a new SET. Reject before player acceptance rather than
+             * promise a terminal from an input which is already quiescing. */
+            vlc_mutex_unlock(&sys->lock_control);
+            return VLC_EGENERIC;
+        }
+        if (sys->strict_frame_active_request_id != 0)
+        {
+            vlc_mutex_unlock(&sys->lock_control);
+            return -EBUSY;
+        }
+        for (size_t index = 0; index < sys->strict_frame_control_count;
+             ++index)
+        {
+            if (StrictFrameControlIsReset(
+                    sys->strict_frame_control[index].i_type))
+            {
+                /* The causal reset already follows the prior generation's
+                 * CANCEL. Refuse this SET until the reset is consumed rather
+                 * than letting a reused generation cross the barrier. */
+                vlc_mutex_unlock(&sys->lock_control);
+                return -EBUSY;
+            }
+        }
+    }
+
+    if (type == INPUT_CONTROL_CANCEL_FRAME_NEXT)
+    {
+        /* Cancellation and output/terminal commitment arbitrate under this
+         * one lock. Once the vout claimed the target immediately before module
+         * submission (or an error terminal claimed its lane), that terminal
+         * wins: it must never be removed and replaced by -ECANCELED. */
+        if (sys->strict_frame_active_request_id
+                == param->frame_next.request_id
+         && sys->strict_frame_active_generation
+                == param->frame_next.generation)
+        {
+            sys->strict_frame_active_request_id = 0;
+            sys->strict_frame_active_generation = 0;
+            sys->strict_frame_commit_claimed = false;
+            vlc_cond_broadcast(&sys->wait_control);
+        }
+
+        for (size_t index = 0; index < sys->strict_frame_control_count;
+             ++index)
+        {
+            input_control_t *pending = &sys->strict_frame_control[index];
+            if (pending->i_type != INPUT_CONTROL_SET_FRAME_NEXT
+             && pending->i_type != INPUT_CONTROL_CANCEL_FRAME_NEXT)
+                continue;
+            if (pending->param.frame_next.request_id
+                    != param->frame_next.request_id
+             || pending->param.frame_next.generation
+                    != param->frame_next.generation)
+                continue;
+
+            if (pending->i_type == INPUT_CONTROL_SET_FRAME_NEXT)
+            {
+                /* The generation never reached the decoder, so cancellation
+                 * can collapse the pending SET instead of queuing a no-op. */
+                --sys->strict_frame_control_count;
+                if (index < sys->strict_frame_control_count)
+                    memmove(pending, pending + 1,
+                            (sys->strict_frame_control_count - index)
+                            * sizeof(*pending));
+            }
+            /* A duplicate matching CANCEL is already guaranteed. */
+            vlc_mutex_unlock(&sys->lock_control);
+            return VLC_SUCCESS;
+        }
+    }
+
+    /* Formal bound: either CANCEL(A)+SET(B) for explicit reusable cancel, or
+     * CANCEL(A)+RESET(A) for a causal reset. SET is rejected while RESET is
+     * pending, and cancel-before-consume collapses SET(A). */
+    assert(sys->strict_frame_control_count < INPUT_STRICT_CONTROL_FIFO_SIZE);
+    if (unlikely(sys->strict_frame_control_count
+                 == INPUT_STRICT_CONTROL_FIFO_SIZE))
+    {
+        /* Release-build invariant fallback: force causal teardown. A CANCEL
+         * is thereby guaranteed; a SET is rejected before being accepted. */
+        sys->is_stopped = true;
+        vlc_cond_broadcast(&sys->wait_control);
+        vlc_mutex_unlock(&sys->lock_control);
+        vlc_interrupt_kill(&sys->interrupt);
+        return type == INPUT_CONTROL_CANCEL_FRAME_NEXT
+             ? VLC_SUCCESS : VLC_EGENERIC;
+    }
+
+    input_control_t *control =
+        &sys->strict_frame_control[sys->strict_frame_control_count];
+    control->i_type = type;
+    control->param = *param;
+    if (!ControlAssignSequenceLocked(input, control))
+    {
+        vlc_mutex_unlock(&sys->lock_control);
+        vlc_interrupt_kill(&sys->interrupt);
+        return type == INPUT_CONTROL_CANCEL_FRAME_NEXT
+             ? VLC_SUCCESS : VLC_EGENERIC;
+    }
+    ++sys->strict_frame_control_count;
+    if (type == INPUT_CONTROL_SET_FRAME_NEXT)
+    {
+        sys->strict_frame_active_request_id = param->frame_next.request_id;
+        sys->strict_frame_active_generation = param->frame_next.generation;
+        sys->strict_frame_commit_claimed = false;
+    }
+    vlc_cond_signal(&sys->wait_control);
+    vlc_mutex_unlock(&sys->lock_control);
+    return VLC_SUCCESS;
+}
+
+int input_ControlPushStrictReset(input_thread_t *input, int type,
+                                 const input_control_param_t *param)
+{
+    assert(StrictFrameControlIsReset(type));
+
+    input_thread_private_t *sys = input_priv(input);
+    vlc_mutex_lock(&sys->lock_control);
+
+    if (sys->is_stopped)
+    {
+        vlc_mutex_unlock(&sys->lock_control);
+        return VLC_EGENERIC;
+    }
+
+    size_t next_index = sys->strict_frame_control_count;
+    if (next_index != 0)
+    {
+        input_control_t *previous = &sys->strict_frame_control[next_index - 1];
+        if (previous->i_type == type
+         && previous->sequence == sys->next_control_sequence
+         && (type == INPUT_CONTROL_SET_STATE
+          || type == INPUT_CONTROL_SET_POSITION
+          || type == INPUT_CONTROL_SET_TIME))
+            /* Match the ordinary FIFO's consecutive-control reduction. The
+             * replacement receives a new global sequence, so an intervening
+             * ordinary control still executes first. */
+            --next_index;
+    }
+
+    assert(next_index < INPUT_STRICT_CONTROL_FIFO_SIZE);
+    if (unlikely(next_index == INPUT_STRICT_CONTROL_FIFO_SIZE))
+    {
+        /* A reset must never be silently dropped because that would allow a
+         * later strict generation to arm on pre-reset decoder/vout state.
+         * Fail closed by stopping this input; future strict SETs are then
+         * rejected by the lifecycle gate. */
+        sys->is_stopped = true;
+        vlc_cond_broadcast(&sys->wait_control);
+        vlc_mutex_unlock(&sys->lock_control);
+        vlc_interrupt_kill(&sys->interrupt);
+        return VLC_EGENERIC;
+    }
+
+    input_control_t *control = &sys->strict_frame_control[next_index];
+    control->i_type = type;
+    memset(&control->param, 0, sizeof(control->param));
+    if (param != NULL)
+        control->param = *param;
+    if (!ControlAssignSequenceLocked(input, control))
+    {
+        vlc_mutex_unlock(&sys->lock_control);
+        vlc_interrupt_kill(&sys->interrupt);
+        return VLC_EGENERIC;
+    }
+    sys->strict_frame_control_count = next_index + 1;
+    vlc_cond_signal(&sys->wait_control);
+    vlc_mutex_unlock(&sys->lock_control);
+    return VLC_SUCCESS;
+}
+
+static bool FrameNextTerminalEnsureCapacityLocked(
+    input_thread_private_t *sys, size_t additional)
+{
+    if (unlikely(sys->frame_next_force_terminal_allocation_failure))
+        return false;
+    if (unlikely(additional > SIZE_MAX - sys->frame_next_displayed_count))
+        return false;
+    const size_t required = sys->frame_next_displayed_count + additional;
+    if (required <= sys->frame_next_displayed_capacity)
+        return true;
+
+    size_t capacity = sys->frame_next_displayed_capacity;
+    while (capacity < required)
+    {
+        if (capacity > SIZE_MAX / 2)
+        {
+            capacity = required;
+            break;
+        }
+        capacity *= 2;
+    }
+    if (unlikely(capacity > SIZE_MAX / sizeof(*sys->frame_next_displayed)))
+        return false;
+
+    input_control_param_t *grown;
+    if (sys->frame_next_displayed == sys->frame_next_displayed_inline)
+    {
+        grown = malloc(capacity * sizeof(*grown));
+        if (grown != NULL)
+            memcpy(grown, sys->frame_next_displayed_inline,
+                   sys->frame_next_displayed_count * sizeof(*grown));
+    }
+    else
+        grown = realloc(sys->frame_next_displayed,
+                        capacity * sizeof(*grown));
+    if (grown == NULL)
+        return false;
+
+    sys->frame_next_displayed = grown;
+    sys->frame_next_displayed_capacity = capacity;
+    return true;
+}
+
+static bool FrameNextTerminalContainsStrictLocked(
+    const input_thread_private_t *sys, uint64_t request_id,
+    uint64_t generation)
+{
+    if (sys->strict_frame_terminal_in_transit_request_id == request_id
+     && sys->strict_frame_terminal_in_transit_generation == generation)
+        return true;
+    if (sys->frame_next_overflow_pending
+     && sys->frame_next_overflow.frame_next.request_id == request_id
+     && sys->frame_next_overflow.frame_next.generation == generation)
+        return true;
+    for (size_t index = 0; index < sys->frame_next_displayed_count; ++index)
+    {
+        const input_control_param_t *pending =
+            &sys->frame_next_displayed[index];
+        if (pending->frame_next.request_id == request_id
+         && pending->frame_next.generation == generation)
+            return true;
+    }
+    return false;
+}
+
+bool input_ControlHasFrameNextTerminal(input_thread_t *input,
+                                       uint64_t request_id,
+                                       uint64_t generation)
+{
+    input_thread_private_t *sys = input_priv(input);
+    vlc_mutex_lock(&sys->lock_control);
+    const bool contains = FrameNextTerminalContainsStrictLocked(
+        sys, request_id, generation);
+    vlc_mutex_unlock(&sys->lock_control);
+    return contains;
+}
+
+static void FrameNextTerminalQueueOverflowLocked(
+    input_thread_private_t *sys, uint64_t request_id, uint64_t generation)
+{
+    /* Allocation failure settles the one generation which is publicly active
+     * now, not necessarily the callback which happened to need a segment.
+     * A committed callback from canceled A can race immediate reuse by B; an
+     * emergency terminal for stale A would suppress and lose B's later sole
+     * terminal. Mapping to active B instead preserves exact settlement. */
+    request_id = sys->strict_frame_active_request_id;
+    generation = sys->strict_frame_active_generation;
+    if (request_id == 0
+     || FrameNextTerminalContainsStrictLocked(sys, request_id, generation))
+        return;
+
+    /* The allocation-free terminal is itself the winning terminal origin. */
+    sys->strict_frame_commit_claimed = true;
+
+    /* A priority terminal must not overtake and orphan its own still-pending
+     * SET. Collapse that SET under the same control lock. If SET was already
+     * popped, the sole input consumer cannot pop this terminal until it has
+     * finished arming the decoder, where CompleteFrameNext(-EOVERFLOW) below
+     * performs the matching downstream cancellation. */
+    for (size_t index = 0; index < sys->strict_frame_control_count; ++index)
+    {
+        input_control_t *pending = &sys->strict_frame_control[index];
+        if (pending->i_type != INPUT_CONTROL_SET_FRAME_NEXT
+         || pending->param.frame_next.request_id != request_id
+         || pending->param.frame_next.generation != generation)
+            continue;
+        --sys->strict_frame_control_count;
+        if (index < sys->strict_frame_control_count)
+            memmove(pending, pending + 1,
+                    (sys->strict_frame_control_count - index)
+                    * sizeof(*pending));
+        break;
+    }
+
+    /* There is at most one publicly accepted strict request. This dedicated
+     * non-allocating slot therefore cannot be consumed by legacy traffic and
+     * cannot overflow. It is delivered only after every terminal which was
+     * already durably queued, preserving the causal prefix. */
+    assert(!sys->frame_next_overflow_pending);
+    if (unlikely(sys->frame_next_overflow_pending))
+        return;
+    sys->frame_next_overflow.frame_next = (typeof(
+        sys->frame_next_overflow.frame_next)) {
+        .request_id = request_id,
+        .generation = generation,
+        .status = -EOVERFLOW,
+        .time = VLC_TICK_INVALID,
+        .position = -1.0,
+        .repeat_count = 1,
+    };
+    sys->frame_next_overflow_pending = true;
+    if (sys->frame_next_terminal_origin_count != UINT64_MAX)
+        ++sys->frame_next_terminal_origin_count;
+    vlc_cond_signal(&sys->wait_control);
+}
+
+static void FrameNextTerminalRecordOriginsLocked(
+    input_thread_private_t *sys, size_t repeat_count)
+{
+    if (repeat_count > UINT64_MAX - sys->frame_next_terminal_origin_count)
+        sys->frame_next_terminal_origin_count = UINT64_MAX;
+    else
+        sys->frame_next_terminal_origin_count += repeat_count;
+}
+
+void input_ControlPushFrameNextDisplayed(input_thread_t *input,
+                                         uint64_t request_id,
+                                         uint64_t generation, int status,
+                                         vlc_tick_t time, double position,
+                                         size_t repeat_count)
+{
+    assert(repeat_count != 0);
+    assert(request_id == 0 || repeat_count == 1);
+    input_thread_private_t *sys = input_priv(input);
+    vlc_mutex_lock(&sys->lock_control);
+
+    if (request_id != 0
+     && !FrameNextClaimCommitLocked(sys, request_id, generation))
+    {
+        /* A synchronous explicit cancel won before this direct/vout terminal
+         * reached the lossless lane. The downstream CANCEL owns cleanup; a
+         * stale terminal must not consume the immediately reused public ID. */
+        vlc_mutex_unlock(&sys->lock_control);
+        return;
+    }
+
+    if (sys->frame_next_overflow_pending)
+    {
+        /* The emergency strict terminal is already the authoritative boundary
+         * after an allocation failure. A duplicate terminal is suppressed;
+         * later legacy output cannot overtake it. */
+        assert(sys->frame_next_overflow.frame_next.request_id != 0);
+        vlc_mutex_unlock(&sys->lock_control);
+        return;
+    }
+
+    if (request_id != 0 && FrameNextTerminalContainsStrictLocked(
+            sys, request_id, generation))
+    {
+        /* Every generation has one winning terminal origin; coalesce a
+         * defensive duplicate without allowing it to consume ring capacity. */
+        vlc_mutex_unlock(&sys->lock_control);
+        return;
+    }
+
+    if (sys->is_stopped && request_id == 0)
+    {
+        vlc_mutex_unlock(&sys->lock_control);
+        return;
+    }
+
+    /* A matching strict generation may finish after input_Stop() once output
+     * commit already won. input_Stop preserved its correlation, and Run's
+     * post-End quiescence barrier will drain this terminal even though the
+     * ordinary control loop is no longer running. */
+
+    /* Legacy terminal callbacks can outnumber the ordinary control FIFO:
+     * input may consume/refill it while the paused vout still owns an older
+     * output batch. Represent each adjacent equal-status legacy run in one
+     * entry. ControlPop expands the run one callback at a time, preserving
+     * exact count and order; a strict terminal is an explicit run boundary. */
+    if (request_id == 0 && sys->frame_next_displayed_count != 0)
+    {
+        input_control_param_t *last = &sys->frame_next_displayed[
+            sys->frame_next_displayed_count - 1];
+        if (last->frame_next.request_id == 0
+         && last->frame_next.status == status)
+        {
+            if (likely(repeat_count <= SIZE_MAX
+                                    - last->frame_next.repeat_count))
+            {
+                last->frame_next.repeat_count += repeat_count;
+                FrameNextTerminalRecordOriginsLocked(sys, repeat_count);
+                vlc_cond_signal(&sys->wait_control);
+                vlc_mutex_unlock(&sys->lock_control);
+                return;
+            }
+            /* Split an arithmetically full run into a second adjacent run.
+             * ControlPop preserves the exact callback sequence and neither
+             * size_t counter wraps. */
+        }
+    }
+
+    /* Alternating output results invalidate any finite segment bound, so grow
+     * this ordered queue. If allocation fails, legacy output is never allowed
+     * to consume the strict emergency slot: the accepted generation receives
+     * one durable EOVERFLOW terminal without invoking listeners under vout or
+     * decoder locks and without stopping the input before delivery. */
+    if (unlikely(!FrameNextTerminalEnsureCapacityLocked(sys, 1)))
+    {
+        FrameNextTerminalQueueOverflowLocked(sys, request_id, generation);
+        vlc_mutex_unlock(&sys->lock_control);
+        return;
+    }
+
+    input_control_param_t *terminal =
+        &sys->frame_next_displayed[sys->frame_next_displayed_count++];
+    terminal->frame_next.request_id = request_id;
+    terminal->frame_next.generation = generation;
+    terminal->frame_next.status = status;
+    terminal->frame_next.time = status == VLC_SUCCESS
+                              ? time : VLC_TICK_INVALID;
+    terminal->frame_next.position = status == VLC_SUCCESS ? position : -1.0;
+    terminal->frame_next.repeat_count = repeat_count;
+    FrameNextTerminalRecordOriginsLocked(sys, repeat_count);
+    vlc_cond_signal(&sys->wait_control);
+    vlc_mutex_unlock(&sys->lock_control);
+}
+
+void input_ControlAcknowledgeFrameNext(input_thread_t *input,
+                                       uint64_t request_id,
+                                       uint64_t generation)
+{
+    input_thread_private_t *sys = input_priv(input);
+    vlc_mutex_lock(&sys->lock_control);
+    if (sys->strict_frame_active_request_id == request_id
+     && sys->strict_frame_active_generation == generation)
+    {
+        sys->strict_frame_active_request_id = 0;
+        sys->strict_frame_active_generation = 0;
+        sys->strict_frame_commit_claimed = false;
+    }
+    if (sys->strict_frame_terminal_in_transit_request_id == 0)
+    {
+        sys->strict_frame_terminal_in_transit_request_id = request_id;
+        sys->strict_frame_terminal_in_transit_generation = generation;
+    }
+    else
+        assert(sys->strict_frame_terminal_in_transit_request_id == request_id
+            && sys->strict_frame_terminal_in_transit_generation
+                == generation);
+    vlc_mutex_unlock(&sys->lock_control);
+}
+
+void input_ControlFinishFrameNextDelivery(input_thread_t *input,
+                                          uint64_t request_id,
+                                          uint64_t generation)
+{
+    input_thread_private_t *sys = input_priv(input);
+    vlc_mutex_lock(&sys->lock_control);
+    if (sys->strict_frame_terminal_in_transit_request_id == request_id
+     && sys->strict_frame_terminal_in_transit_generation == generation)
+    {
+        sys->strict_frame_terminal_in_transit_request_id = 0;
+        sys->strict_frame_terminal_in_transit_generation = 0;
+    }
+    vlc_mutex_unlock(&sys->lock_control);
+}
+
+void input_ControlForceFrameNextTerminalAllocationFailure(
+    input_thread_t *input, bool enabled)
+{
+    input_thread_private_t *sys = input_priv(input);
+    vlc_mutex_lock(&sys->lock_control);
+    sys->frame_next_force_terminal_allocation_failure = enabled;
+    vlc_mutex_unlock(&sys->lock_control);
+}
+
+static void input_QueueOrSendFrameNextStatus(input_thread_t *input,
+                                             int status,
+                                             uint64_t request_id,
+                                             uint64_t generation)
+{
+    if (request_id != 0)
+    {
+        input_ControlPushFrameNextDisplayed(input, request_id, generation,
+                                            status, VLC_TICK_INVALID, -1.0, 1);
+        return;
+    }
+
+    input_SendEvent(input, &(struct vlc_input_event) {
+        .type = INPUT_EVENT_FRAME_NEXT_STATUS,
+        .frame_next = {
+            .status = status,
+            .request_id = 0,
+            .generation = 0,
+            .time = VLC_TICK_INVALID,
+            .position = -1.0,
+        },
+    });
+}
+
+void input_ControlSetFrameNextNeedData(input_thread_t *input, bool need_data)
+{
+    input_thread_private_t *sys = input_priv(input);
+    vlc_mutex_lock(&sys->lock_control);
+    if (!sys->is_stopped)
+    {
+        /* This is level-triggered state, so coalescing to the newest value is
+         * both lossless and preferable to filling the ordinary control FIFO. */
+        sys->frame_next_need_data_value = need_data;
+        sys->frame_next_need_data_pending = true;
+        vlc_cond_signal(&sys->wait_control);
+    }
+    vlc_mutex_unlock(&sys->lock_control);
+}
+
+void input_ControlRequestFrameNextPictures(input_thread_t *input,
+                                           uint64_t request_id,
+                                           uint64_t generation,
+                                           uint64_t observation)
+{
+    input_thread_private_t *sys = input_priv(input);
+    vlc_mutex_lock(&sys->lock_control);
+    if (!sys->is_stopped)
+    {
+        if (sys->frame_next_replacement_pending)
+        {
+            const input_control_param_t *pending =
+                &sys->frame_next_replacement;
+            /* One strict generation can produce only one outstanding
+             * replacement level. A later generation cannot render/drop until
+             * this priority item has been popped ahead of its SET control. */
+            if (unlikely(
+                pending->frame_next_replacement.request_id != request_id
+             || pending->frame_next_replacement.generation != generation))
+            {
+                assert(!"two strict replacement generations pending");
+                sys->is_stopped = true;
+                vlc_cond_broadcast(&sys->wait_control);
+                vlc_mutex_unlock(&sys->lock_control);
+                vlc_interrupt_kill(&sys->interrupt);
+                return;
+            }
+            sys->frame_next_replacement.frame_next_replacement.observation =
+                observation;
+        }
+        else
+        {
+            sys->frame_next_replacement.frame_next_replacement = (typeof(
+                sys->frame_next_replacement.frame_next_replacement)) {
+                .request_id = request_id,
+                .generation = generation,
+                .observation = observation,
+            };
+            sys->frame_next_replacement_pending = true;
+        }
+        vlc_cond_signal(&sys->wait_control);
+    }
+    vlc_mutex_unlock(&sys->lock_control);
+}
+
+static const input_control_t *
+ControlPeekOrderedLocked(const input_thread_private_t *sys)
+{
+    if (sys->strict_frame_control_count == 0)
+        return sys->i_control == 0 ? NULL : &sys->control[0];
+    if (sys->i_control == 0)
+        return &sys->strict_frame_control[0];
+
+    return sys->strict_frame_control[0].sequence < sys->control[0].sequence
+         ? &sys->strict_frame_control[0] : &sys->control[0];
+}
+
+static bool
+FrameNextTerminalPopLocked(input_thread_private_t *sys,
+                           input_control_param_t *param)
+{
+    if (sys->frame_next_displayed_count != 0)
+    {
