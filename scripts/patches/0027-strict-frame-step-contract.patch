+bool vout_DiscardDrainedNextPictures(vout_thread_t *vout,
+                                     size_t missing_count,
+                                     uint64_t strict_request_id,
+                                     uint64_t strict_generation)
+{
+    vout_thread_sys_t *sys = VOUT_THREAD_TO_SYS(vout);
+    assert(!sys->dummy);
+    assert(missing_count > 0);
+
+    vout_control_Hold(&sys->control);
+
+    bool valid = missing_count <= sys->frame_next_count;
+    const size_t retained_count = valid
+                                ? sys->frame_next_count - missing_count : 0;
+    if (valid && strict_request_id != 0)
+    {
+        valid = sys->strict_frame.target_request_id == strict_request_id
+             && sys->strict_frame.target_generation == strict_generation
+             && sys->strict_frame.countdown > retained_count;
+    }
+    else if (valid && sys->strict_frame.target_request_id != 0)
+    {
+        /* The retained strict target must not be part of the drained suffix. */
+        valid = sys->strict_frame.countdown <= retained_count;
+    }
+
+    if (likely(valid))
+    {
+        sys->frame_next_count = retained_count;
+        if (strict_request_id != 0)
+        {
+            sys->strict_frame.target_request_id = 0;
+            sys->strict_frame.target_generation = 0;
+            sys->strict_frame.countdown = 0;
+        }
+        if (retained_count == 0)
+            vout_ClearStrictFrame(sys);
+    }
+    else
+    {
+        /* A mismatch is an engine invariant failure, but carrying an
+         * aggregate count or raw decoder callback across the next flush is
+         * worse in release builds. Fail closed and let the decoder publish an
+         * exact -EIO terminal for the generation it still owns. */
+        assert(valid);
+        sys->frame_next_count = 0;
+        vout_ClearStrictFrame(sys);
+    }
+
+    vout_control_ReleaseAndWake(&sys->control);
+    return valid;
+}
