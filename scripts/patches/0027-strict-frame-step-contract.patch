+    sys->strict_frame.observer_generation = observer_generation;
+    sys->strict_frame.claim_commit = claim_commit;
+    sys->strict_frame.displayed = displayed;
+    sys->strict_frame.standard = standard;
+    sys->strict_frame.needs_pictures = needs_pictures;
+    sys->strict_frame.standard_skip_count = 0;
+    sys->strict_frame.next_observation = 0;
+    sys->strict_frame.no_output_observation = 0;
+    sys->strict_frame.opaque = opaque;
+
+    /* Final-output accounting starts before the render thread wakes. A
+     * filter-pending picture can therefore never consume the member in the
+     * old raw-FIFO/status gap. */
+    vout_control_ReleaseAndWake(&sys->control);
