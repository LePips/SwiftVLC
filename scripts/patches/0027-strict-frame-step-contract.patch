+int
+vlc_player_NormalizeOutputClockPoint(vlc_player_t *player,
+                                     vlc_tick_t clock_ts,
+                                     vlc_tick_t *out_ts, double *out_pos)
+{
+    int ret = VLC_EGENERIC;
+    vlc_mutex_lock(&player->timer.lock);
+
+    if (clock_ts == VLC_TICK_INVALID
+     || player->timer.input_normal_time < VLC_TICK_0)
+        goto end;
+
+    const vlc_tick_t media_offset = clock_ts
+        - player->timer.input_normal_time - player->timer.start_offset;
+    const vlc_tick_t time = media_offset + VLC_TICK_0;
+    double position;
+    if (player->timer.input_length != VLC_TICK_INVALID
+     && player->timer.input_length > VLC_TICK_0
+     && !player->timer.input_live)
+    {
+        position = media_offset / (double) player->timer.input_length;
+        if (position < 0.0)
+            position = 0.0;
+        else if (position > 1.0)
+            position = 1.0;
+    }
+    else
+        /* A fractional position is defined by a finite stable length. Input
+         * sources commonly publish a placeholder zero for live/unknown
+         * length media; forwarding it would invent a meaningful landing at
+         * the beginning even when the exact output timestamp has advanced. */
+        position = -1.0;
+
+    /* Live and unknown-length inputs can have an exact media timestamp while
+     * no stable fractional position exists. Preserve that authoritative time
+     * and publish -1 for the optional position instead of turning a proven
+     * output submission into a false engine failure. */
+    if (time < VLC_TICK_0)
+        goto end;
+    if (out_ts != NULL)
+        *out_ts = time;
+    if (out_pos != NULL)
+        *out_pos = position;
+    ret = VLC_SUCCESS;
+end:
+    vlc_mutex_unlock(&player->timer.lock);
+    return ret;
+}
