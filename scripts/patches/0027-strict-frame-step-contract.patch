+int swiftvlc_libvlc_video_set_callbacks_atomic(
+    libvlc_media_player_t *mp,
+    libvlc_video_lock_cb lock_cb,
+    libvlc_video_unlock_cb unlock_cb,
+    libvlc_video_display_cb display_cb,
+    swiftvlc_video_display_status_cb display_status_cb,
+    swiftvlc_video_format_ex_cb setup_cb,
+    libvlc_video_cleanup_cb cleanup_cb,
+    void *opaque)
+{
+    const bool clearing = lock_cb == NULL && unlock_cb == NULL &&
+                          display_cb == NULL && display_status_cb == NULL &&
+                          setup_cb == NULL && cleanup_cb == NULL &&
+                          opaque == NULL;
+    const bool enabling = lock_cb != NULL && display_status_cb != NULL &&
+                          setup_cb != NULL;
+    if (!clearing && !enabling)
+    {
+        libvlc_printerr("Invalid partial atomic vmem callback generation");
+        return -EINVAL;
+    }
+
+    if (!swiftvlc_vmem_configuration_registry_PublishComplete(
+            mp->vmem_configuration, lock_cb, unlock_cb, display_cb,
+            display_status_cb, setup_cb, cleanup_cb, opaque))
+    {
+        libvlc_printerr("Not enough memory to publish atomic vmem callbacks");
+        return -ENOMEM;
+    }
+
+    /* These variables retain source compatibility for diagnostics and older
+     * consumers. The vmem module uses only the already-published immutable
+     * registry whenever it exists, so these sequential mirrors are never an
+     * Open-time configuration source. */
+    var_SetAddress(mp, "vmem-lock", lock_cb);
+    var_SetAddress(mp, "vmem-unlock", unlock_cb);
+    var_SetAddress(mp, "vmem-display", display_cb);
+    var_SetAddress(mp, "vmem-display-status", display_status_cb);
+    var_SetAddress(mp, "vmem-data", opaque);
+    var_SetAddress(mp, "vmem-setup", NULL);
+    var_SetAddress(mp, "vmem-setup-ex", setup_cb);
+    var_SetAddress(mp, "vmem-cleanup", cleanup_cb);
+
+    if (enabling)
+    {
+        var_SetString(mp, "dec-dev", "none");
+        var_SetString(mp, "vout", "vmem");
+        var_SetString(mp, "window", "dummy");
+    }
+    return 0;
+}
