+swiftvlc_next_frame_request_result_t
+swiftvlc_libvlc_media_player_request_next_frame(
+    libvlc_media_player_t *p_mi, uint64_t request_id )
+{
+    if (request_id == 0)
+        return swiftvlc_next_frame_request_invalid;
+
+    vlc_player_t *player = p_mi->player;
+    vlc_player_Lock(player);
+    int ret = vlc_player_RequestNextVideoFrame(player, request_id);
+    vlc_player_Unlock(player);
+
+    switch (ret)
+    {
+        case VLC_SUCCESS:
+            return swiftvlc_next_frame_request_accepted;
+        case -EBUSY:
+            return swiftvlc_next_frame_request_busy;
+        case -EINVAL:
+            return swiftvlc_next_frame_request_invalid;
+        case -ENOTSUP:
+        default:
+            return swiftvlc_next_frame_request_unavailable;
+    }
+}
+
+bool
+swiftvlc_libvlc_media_player_cancel_next_frame_request(
+    libvlc_media_player_t *p_mi, uint64_t request_id )
+{
+    if (request_id == 0)
+        return false;
+
+    vlc_player_t *player = p_mi->player;
+    vlc_player_Lock(player);
+    bool canceled = vlc_player_CancelNextVideoFrame(player, request_id);
+    vlc_player_Unlock(player);
+    return canceled;
+}
