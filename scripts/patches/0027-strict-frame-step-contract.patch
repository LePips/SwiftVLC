diff --git a/include/vlc_vmem_configuration.h b/include/vlc_vmem_configuration.h
new file mode 100644
index 0000000000..64d5179aba
--- /dev/null
+++ b/include/vlc_vmem_configuration.h
@@ -0,0 +1,280 @@
+/*****************************************************************************
+ * vlc_vmem_configuration.h: immutable LibVLC vmem callback generations
+ *****************************************************************************
+ * Copyright (C) 2026 SwiftVLC authors
+ *
+ * This file is part of VLC, and is licensed under the GNU Lesser General
+ * Public License version 2.1 or later.
+ *****************************************************************************/
+
+#ifndef VLC_VMEM_CONFIGURATION_H
+#define VLC_VMEM_CONFIGURATION_H 1
+
+#include <stdlib.h>
+
+#include <vlc_atomic.h>
+#include <vlc_threads.h>
+#include <vlc/swiftvlc_vmem.h>
+
+typedef void *(*swiftvlc_vmem_lock_cb)(void *, void **);
+typedef void (*swiftvlc_vmem_unlock_cb)(void *, void *, void *const *);
+typedef void (*swiftvlc_vmem_display_cb)(void *, void *);
+typedef unsigned (*swiftvlc_vmem_format_cb)(void **, char *, unsigned *,
+                                            unsigned *, unsigned *, unsigned *);
+typedef void (*swiftvlc_vmem_cleanup_cb)(void *);
+
+/**
+ * One immutable callback generation.
+ *
+ * The registry owns one reference and every opened vmem output owns another.
+ * In particular, setup/cleanup/opaque can never be taken from different
+ * setter generations. The setup callback may replace an output's private copy
+ * of opaque; Close still invokes the cleanup function retained here.
+ */
+typedef struct swiftvlc_vmem_configuration
+{
+    vlc_atomic_rc_t rc;
+    swiftvlc_vmem_lock_cb lock;
+    swiftvlc_vmem_unlock_cb unlock;
+    swiftvlc_vmem_display_cb display;
+    swiftvlc_video_display_status_cb display_status;
+    swiftvlc_vmem_format_cb setup;
+    swiftvlc_video_format_ex_cb setup_ex;
+    swiftvlc_vmem_cleanup_cb cleanup;
+    void *opaque;
+} swiftvlc_vmem_configuration;
+
+typedef struct swiftvlc_vmem_configuration_registry
+{
+    vlc_mutex_t lock;
+    swiftvlc_vmem_configuration *current;
+    /* Private source-linked validation hook. It forces the exact immutable
+     * generation allocator failure path without replacing the registry with
+     * a disconnected model. */
+    atomic_bool force_allocation_failure;
+} swiftvlc_vmem_configuration_registry;
+
+static inline swiftvlc_vmem_configuration *
+swiftvlc_vmem_configuration_NewEmpty(void)
+{
+    swiftvlc_vmem_configuration *configuration =
+        calloc(1, sizeof(*configuration));
+    if (configuration != NULL)
+        vlc_atomic_rc_init(&configuration->rc);
+    return configuration;
+}
+
+static inline swiftvlc_vmem_configuration *
+swiftvlc_vmem_configuration_Clone(
+    const swiftvlc_vmem_configuration *source)
+{
+    swiftvlc_vmem_configuration *configuration =
+        malloc(sizeof(*configuration));
+    if (configuration == NULL)
+        return NULL;
+
+    vlc_atomic_rc_init(&configuration->rc);
+    configuration->lock = source->lock;
+    configuration->unlock = source->unlock;
+    configuration->display = source->display;
+    configuration->display_status = source->display_status;
+    configuration->setup = source->setup;
+    configuration->setup_ex = source->setup_ex;
+    configuration->cleanup = source->cleanup;
+    configuration->opaque = source->opaque;
+    return configuration;
+}
+
+static inline void
+swiftvlc_vmem_configuration_Release(
+    const swiftvlc_vmem_configuration *configuration)
+{
+    if (configuration != NULL &&
+        vlc_atomic_rc_dec((vlc_atomic_rc_t *)&configuration->rc))
+        free((void *)configuration);
+}
+
+static inline swiftvlc_vmem_configuration_registry *
+swiftvlc_vmem_configuration_registry_New(void)
+{
+    swiftvlc_vmem_configuration_registry *registry =
+        malloc(sizeof(*registry));
+    if (registry == NULL)
+        return NULL;
+
+    registry->current = swiftvlc_vmem_configuration_NewEmpty();
+    if (registry->current == NULL)
+    {
+        free(registry);
+        return NULL;
+    }
+    vlc_mutex_init(&registry->lock);
+    atomic_init(&registry->force_allocation_failure, false);
+    return registry;
+}
+
+static inline void
+swiftvlc_vmem_configuration_registry_Delete(
+    swiftvlc_vmem_configuration_registry *registry)
+{
+    if (registry == NULL)
+        return;
+
+    vlc_mutex_lock(&registry->lock);
+    swiftvlc_vmem_configuration *configuration = registry->current;
+    registry->current = NULL;
+    vlc_mutex_unlock(&registry->lock);
+    swiftvlc_vmem_configuration_Release(configuration);
+    free(registry);
+}
+
+static inline const swiftvlc_vmem_configuration *
+swiftvlc_vmem_configuration_registry_Acquire(
+    swiftvlc_vmem_configuration_registry *registry)
+{
+    if (registry == NULL)
+        return NULL;
+
+    vlc_mutex_lock(&registry->lock);
+    swiftvlc_vmem_configuration *configuration = registry->current;
+    if (configuration != NULL)
+        vlc_atomic_rc_inc(&configuration->rc);
+    vlc_mutex_unlock(&registry->lock);
+    return configuration;
+}
+
+static inline bool
+swiftvlc_vmem_configuration_registry_PublishCallbacks(
+    swiftvlc_vmem_configuration_registry *registry,
+    swiftvlc_vmem_lock_cb lock, swiftvlc_vmem_unlock_cb unlock,
+    swiftvlc_vmem_display_cb display, void *opaque)
+{
+    vlc_mutex_lock(&registry->lock);
+    swiftvlc_vmem_configuration *previous = registry->current;
+    swiftvlc_vmem_configuration *next =
+        swiftvlc_vmem_configuration_Clone(previous);
+    if (next != NULL)
+    {
+        next->lock = lock;
+        next->unlock = unlock;
+        next->display = display;
+        /* Preserve the historical standard-setter behavior, but publish its
+         * complete legacy generation atomically. SwiftVLC uses the combined
+         * publisher below, so it never exposes this deliberate legacy-only
+         * generation during install/rebind. */
+        next->display_status = NULL;
+        next->opaque = opaque;
+        registry->current = next;
+    }
+    vlc_mutex_unlock(&registry->lock);
+    if (next != NULL)
+        swiftvlc_vmem_configuration_Release(previous);
+    return next != NULL;
+}
+
+static inline bool
+swiftvlc_vmem_configuration_registry_PublishComplete(
+    swiftvlc_vmem_configuration_registry *registry,
+    swiftvlc_vmem_lock_cb lock, swiftvlc_vmem_unlock_cb unlock,
+    swiftvlc_vmem_display_cb display,
+    swiftvlc_video_display_status_cb display_status,
+    swiftvlc_video_format_ex_cb setup_ex,
+    swiftvlc_vmem_cleanup_cb cleanup, void *opaque)
+{
+    if (atomic_load_explicit(&registry->force_allocation_failure,
+                             memory_order_acquire))
+        return false;
+    swiftvlc_vmem_configuration *next =
+        swiftvlc_vmem_configuration_NewEmpty();
+    if (next == NULL)
+        return false;
+
+    next->lock = lock;
+    next->unlock = unlock;
+    next->display = display;
+    next->display_status = display_status;
+    next->setup_ex = setup_ex;
+    next->cleanup = cleanup;
+    next->opaque = opaque;
+
+    vlc_mutex_lock(&registry->lock);
+    swiftvlc_vmem_configuration *previous = registry->current;
+    registry->current = next;
+    vlc_mutex_unlock(&registry->lock);
+    swiftvlc_vmem_configuration_Release(previous);
+    return true;
+}
+
+static inline void
+swiftvlc_vmem_configuration_registry_ForceAllocationFailure(
+    swiftvlc_vmem_configuration_registry *registry, bool enabled)
+{
+    atomic_store_explicit(&registry->force_allocation_failure, enabled,
+                          memory_order_release);
+}
+
+static inline bool
+swiftvlc_vmem_configuration_registry_PublishFormat(
+    swiftvlc_vmem_configuration_registry *registry,
+    swiftvlc_vmem_format_cb setup, swiftvlc_vmem_cleanup_cb cleanup)
+{
+    vlc_mutex_lock(&registry->lock);
+    swiftvlc_vmem_configuration *previous = registry->current;
+    swiftvlc_vmem_configuration *next =
+        swiftvlc_vmem_configuration_Clone(previous);
+    if (next != NULL)
+    {
+        next->setup = setup;
+        next->setup_ex = NULL;
+        next->cleanup = cleanup;
+        registry->current = next;
+    }
+    vlc_mutex_unlock(&registry->lock);
+    if (next != NULL)
+        swiftvlc_vmem_configuration_Release(previous);
+    return next != NULL;
+}
+
+static inline bool
+swiftvlc_vmem_configuration_registry_PublishFormatEx(
+    swiftvlc_vmem_configuration_registry *registry,
+    swiftvlc_video_format_ex_cb setup, swiftvlc_vmem_cleanup_cb cleanup)
+{
+    vlc_mutex_lock(&registry->lock);
+    swiftvlc_vmem_configuration *previous = registry->current;
+    swiftvlc_vmem_configuration *next =
+        swiftvlc_vmem_configuration_Clone(previous);
+    if (next != NULL)
+    {
+        next->setup = NULL;
+        next->setup_ex = setup;
+        next->cleanup = cleanup;
+        registry->current = next;
+    }
+    vlc_mutex_unlock(&registry->lock);
+    if (next != NULL)
+        swiftvlc_vmem_configuration_Release(previous);
+    return next != NULL;
+}
+
+static inline bool
+swiftvlc_vmem_configuration_registry_PublishDisplayStatus(
+    swiftvlc_vmem_configuration_registry *registry,
+    swiftvlc_video_display_status_cb display_status)
+{
+    vlc_mutex_lock(&registry->lock);
+    swiftvlc_vmem_configuration *previous = registry->current;
+    swiftvlc_vmem_configuration *next =
+        swiftvlc_vmem_configuration_Clone(previous);
+    if (next != NULL)
+    {
+        next->display_status = display_status;
+        registry->current = next;
+    }
+    vlc_mutex_unlock(&registry->lock);
+    if (next != NULL)
+        swiftvlc_vmem_configuration_Release(previous);
+    return next != NULL;
+}
+
+#endif /* VLC_VMEM_CONFIGURATION_H */
