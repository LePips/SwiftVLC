+    if (control == NULL || !vlc_atomic_rc_dec(&control->rc))
+        return;
+    assert(vlc_list_is_empty(&control->registrations));
+    free(control);
+}
+
+uint64_t
+aout_MediaServicesCommandPublish(
+    vlc_audio_media_services_control_t *control,
+    enum vlc_audio_media_services_command_origin origin, uint64_t reset_epoch)
+{
+    vlc_mutex_lock(&control->lock);
+    uint64_t generation = ++control->snapshot.generation;
+    if (unlikely(generation == 0))
+        generation = ++control->snapshot.generation;
+    control->snapshot.origin = origin;
+    control->snapshot.reset_epoch =
+        origin == VLC_AUDIO_MEDIA_SERVICES_COMMAND_EXPLICIT_RESUME
+        ? reset_epoch : 0;
+    control->snapshot.dispatched = false;
+    control->terminal_generation = 0;
+    if (origin == VLC_AUDIO_MEDIA_SERVICES_COMMAND_EXPLICIT_RESUME)
+    {
+        control->snapshot.acknowledged_reset_epoch = 0;
+        control->acknowledgement_vacuous = false;
+    }
+    else if (control->acknowledgement_vacuous)
+    {
+        /* A no-output acknowledgement authorizes only an output that joins
+         * the same explicit command. Stop/media replacement and every other
+         * invalidating boundary must not arm an unrelated future Start. */
+        control->snapshot.acknowledged_reset_epoch = 0;
+        control->acknowledgement_vacuous = false;
+    }
+    vlc_mutex_unlock(&control->lock);
+    return generation;
+}
+
+bool
+aout_MediaServicesCommandDispatch(vlc_audio_media_services_control_t *control,
+                                  uint64_t generation)
+{
+    vlc_mutex_lock(&control->lock);
+    if (control->snapshot.generation != generation
+     || control->snapshot.origin !=
+            VLC_AUDIO_MEDIA_SERVICES_COMMAND_EXPLICIT_RESUME)
+    {
+        vlc_mutex_unlock(&control->lock);
+        return false;
+    }
+    control->snapshot.dispatched = true;
+
+    for (;;)
+    {
+        struct vlc_audio_media_services_registration *registration = NULL;
+        struct vlc_audio_media_services_registration *candidate;
+        vlc_list_foreach(candidate, &control->registrations, node)
+        {
+            if (!candidate->closing
+             && candidate->last_dispatched_generation != generation)
+            {
+                registration = candidate;
+                break;
+            }
+        }
+        if (registration == NULL
+         || control->snapshot.generation != generation)
+        {
+            bool current = control->snapshot.generation == generation;
+            if (current && control->snapshot.live_output_count == 0
+             && control->terminal_generation != generation)
+            {
+                /* A video-only player has no output participant to rebuild.
+                 * Register() revokes this vacuous acknowledgement and
+                 * bootstraps the exact command if an output appears later. */
+                control->snapshot.acknowledged_reset_epoch =
+                    control->snapshot.reset_epoch;
+                control->acknowledgement_vacuous = true;
+            }
+            vlc_mutex_unlock(&control->lock);
+            return current;
+        }
+
+        registration->last_dispatched_generation = generation;
+        registration->active_callbacks++;
+        audio_output_t *aout = registration->aout;
+        vlc_audio_media_services_resume_cb callback = registration->callback;
+        uint64_t reset_epoch = control->snapshot.reset_epoch;
+        vlc_mutex_unlock(&control->lock);
+
+        (void) callback(aout, generation, reset_epoch);
+
+        vlc_mutex_lock(&control->lock);
+        assert(registration->active_callbacks != 0);
+        registration->active_callbacks--;
+        if (registration->closing && registration->active_callbacks == 0)
+            vlc_cond_broadcast(&control->callbacks_drained);
+        if (control->snapshot.generation != generation)
+        {
+            vlc_mutex_unlock(&control->lock);
+            return false;
+        }
+    }
+}
+
+struct vlc_audio_media_services_command_snapshot
+aout_MediaServicesControlSnapshot(vlc_audio_media_services_control_t *control)
+{
+    struct vlc_audio_media_services_command_snapshot snapshot = { 0 };
+    if (control == NULL)
+        return snapshot;
+    vlc_mutex_lock(&control->lock);
+    snapshot = control->snapshot;
+    vlc_mutex_unlock(&control->lock);
+    return snapshot;
+}
+
+struct vlc_audio_media_services_registration *
+aout_MediaServicesCommandRegister(audio_output_t *aout,
+                                  vlc_audio_media_services_resume_cb callback)
+{
+    if (aout->media_services_control == NULL || callback == NULL)
+        return NULL;
+    struct vlc_audio_media_services_registration *registration =
+        calloc(1, sizeof(*registration));
+    if (registration == NULL)
+        return NULL;
+
+    registration->control = aout->media_services_control;
+    registration->aout = aout;
+    registration->callback = callback;
+    vlc_mutex_lock(&registration->control->lock);
+    registration->control->snapshot.output_incarnation_count++;
+    registration->control->snapshot.live_output_count++;
+    if (registration->control->snapshot.origin ==
+            VLC_AUDIO_MEDIA_SERVICES_COMMAND_EXPLICIT_RESUME
+     && registration->control->snapshot.dispatched
+     && registration->control->snapshot.acknowledged_reset_epoch ==
+            registration->control->snapshot.reset_epoch)
+    {
+        registration->control->snapshot.acknowledged_reset_epoch = 0;
+        registration->control->acknowledgement_vacuous = false;
+    }
+    vlc_list_append(&registration->node,
+                    &registration->control->registrations);
+    vlc_mutex_unlock(&registration->control->lock);
+    return registration;
+}
+
+bool
+aout_MediaServicesCommandBootstrap(
+    struct vlc_audio_media_services_registration *registration)
+{
+    if (registration == NULL)
+        return false;
+    vlc_audio_media_services_control_t *control = registration->control;
+    vlc_mutex_lock(&control->lock);
+    uint64_t generation = control->snapshot.generation;
+    if (registration->closing
+     || control->snapshot.origin !=
+            VLC_AUDIO_MEDIA_SERVICES_COMMAND_EXPLICIT_RESUME
+     || !control->snapshot.dispatched
+     || control->terminal_generation == generation
+     || registration->last_dispatched_generation == generation)
+    {
+        vlc_mutex_unlock(&control->lock);
+        return false;
+    }
+
+    registration->last_dispatched_generation = generation;
+    registration->active_callbacks++;
+    audio_output_t *aout = registration->aout;
+    vlc_audio_media_services_resume_cb callback = registration->callback;
+    uint64_t reset_epoch = control->snapshot.reset_epoch;
+    vlc_mutex_unlock(&control->lock);
+
+    (void) callback(aout, generation, reset_epoch);
+
+    vlc_mutex_lock(&control->lock);
+    assert(registration->active_callbacks != 0);
+    registration->active_callbacks--;
+    if (registration->closing && registration->active_callbacks == 0)
+        vlc_cond_broadcast(&control->callbacks_drained);
+    bool current = control->snapshot.generation == generation;
+    vlc_mutex_unlock(&control->lock);
+    return current;
+}
+
+void
+aout_MediaServicesCommandUnregister(
+    struct vlc_audio_media_services_registration *registration)
+{
+    if (registration == NULL)
+        return;
+    vlc_audio_media_services_control_t *control = registration->control;
+    vlc_mutex_lock(&control->lock);
+    registration->closing = true;
+    vlc_list_remove(&registration->node);
+    assert(control->snapshot.live_output_count != 0);
+    control->snapshot.live_output_count--;
+    if (control->snapshot.live_output_count == 0
+     && control->snapshot.origin ==
+            VLC_AUDIO_MEDIA_SERVICES_COMMAND_EXPLICIT_RESUME
+     && control->snapshot.dispatched
+     && control->terminal_generation != control->snapshot.generation)
+    {
+        control->snapshot.acknowledged_reset_epoch =
+            control->snapshot.reset_epoch;
+        control->acknowledgement_vacuous = true;
+    }
+    else if (control->snapshot.live_output_count != 0
+     && control->snapshot.origin ==
+            VLC_AUDIO_MEDIA_SERVICES_COMMAND_EXPLICIT_RESUME
+     && control->snapshot.dispatched
+     && control->terminal_generation != control->snapshot.generation)
+    {
+        bool all_acknowledged = true;
+        struct vlc_audio_media_services_registration *candidate;
+        vlc_list_foreach(candidate, &control->registrations, node)
+            all_acknowledged &= candidate->acknowledged_generation ==
+                                control->snapshot.generation;
+        if (all_acknowledged)
+        {
+            control->snapshot.acknowledged_reset_epoch =
+                control->snapshot.reset_epoch;
+            control->acknowledgement_vacuous = false;
+        }
+    }
+    while (registration->active_callbacks != 0)
+        vlc_cond_wait(&control->callbacks_drained, &control->lock);
+    vlc_mutex_unlock(&control->lock);
+    free(registration);
+}
+
+struct vlc_audio_media_services_command_snapshot
+aout_MediaServicesCommandSnapshot(audio_output_t *aout)
+{
+    return aout_MediaServicesControlSnapshot(aout->media_services_control);
+}
+
+bool
+aout_MediaServicesCommandAcknowledge(audio_output_t *aout,
+                                      uint64_t generation,
+                                      uint64_t reset_epoch)
+{
+    vlc_audio_media_services_control_t *control = aout->media_services_control;
+    if (control == NULL)
+        return false;
+    vlc_mutex_lock(&control->lock);
+    bool current = control->snapshot.generation == generation
+                && control->snapshot.origin ==
+                    VLC_AUDIO_MEDIA_SERVICES_COMMAND_EXPLICIT_RESUME
+                && control->snapshot.dispatched
+                && control->snapshot.reset_epoch == reset_epoch;
+    if (current)
+    {
+        struct vlc_audio_media_services_registration *registration;
+        bool found = false;
+        vlc_list_foreach(registration, &control->registrations, node)
+        {
+            if (registration->aout == aout && !registration->closing)
+            {
+                registration->acknowledged_generation = generation;
+                found = true;
+                break;
+            }
+        }
+        current = found;
+        if (current)
+        {
+            bool all_acknowledged = true;
+            vlc_list_foreach(registration, &control->registrations, node)
+                all_acknowledged &= registration->acknowledged_generation ==
+                                    generation;
+            if (all_acknowledged)
+            {
+                control->snapshot.acknowledged_reset_epoch = reset_epoch;
+                control->acknowledgement_vacuous = false;
+            }
+        }
+    }
+    vlc_mutex_unlock(&control->lock);
+    return current;
+}
+
+void
+aout_MediaServicesReportRecoveryAttempt(audio_output_t *aout)
+{
+    vlc_audio_media_services_control_t *control = aout->media_services_control;
+    if (control == NULL)
+        return;
+    vlc_mutex_lock(&control->lock);
+    control->snapshot.explicit_resume_attempt_count++;
+    vlc_mutex_unlock(&control->lock);
+}
+
+void
+aout_MediaServicesReportRecoveryResult(audio_output_t *aout,
+                                       uint64_t generation,
+                                       uint64_t reset_epoch, bool success,
+                                       bool rebuilt)
+{
+    vlc_audio_media_services_control_t *control = aout->media_services_control;
+    if (control == NULL)
+        return;
+    vlc_mutex_lock(&control->lock);
+    if (!success && generation != 0
+     && control->snapshot.generation == generation
+     && control->snapshot.reset_epoch == reset_epoch
+     && control->snapshot.origin ==
+            VLC_AUDIO_MEDIA_SERVICES_COMMAND_EXPLICIT_RESUME)
+        /* A terminally failed one-shot command may not bootstrap a later
+         * output incarnation. Already-live participants were dispatched by
+         * the current loop and remain free to finish their own one attempt. */
+        control->terminal_generation = generation;
+    if (success && rebuilt)
+        control->snapshot.successful_rebuild_count++;
+    else if (!success)
+        control->snapshot.explicit_resume_failure_count++;
+    vlc_mutex_unlock(&control->lock);
+}
+
 
