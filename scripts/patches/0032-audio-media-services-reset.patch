+ * returns the opaque payload only while callbacks are accepted and pins it
+ * until End(). Invalidate() is wait-free; Destroy() may wait and is valid
+ * only after the AudioUnit can no longer begin callbacks. */
+struct vlc_apple_audio_render_context;
+VLC_API struct vlc_apple_audio_render_context *
+vlc_apple_audio_render_context_create(void *payload);
+VLC_API void *vlc_apple_audio_render_context_begin(
+    struct vlc_apple_audio_render_context *context);
+VLC_API void vlc_apple_audio_render_context_end(
+    struct vlc_apple_audio_render_context *context);
+VLC_API void vlc_apple_audio_render_context_invalidate(
+    struct vlc_apple_audio_render_context *context);
+VLC_API void vlc_apple_audio_render_context_destroy(
+    struct vlc_apple_audio_render_context *context);
+
+/** Hand invalid objects to the process broker when an output closes during
