+                                             bool reset);
+
+/** Read a coherent process-wide media-services phase. */
+VLC_API struct vlc_apple_audio_session_snapshot
+vlc_apple_audio_session_snapshot(void);
+
+/** Serialize every process-global AVAudioSession category, preference, and
+ * activation transaction. No notification callback takes this lock. */
+VLC_API void vlc_apple_audio_session_lock(void);
+VLC_API void vlc_apple_audio_session_unlock(void);
+
+/** Return the current recursive transaction generation. Callers capture this
+ * immediately after locking, then revalidate after every synchronous Apple
+ * framework call. A same-thread notification callback that recursively
+ * enters the broker advances the generation and invalidates the outer
+ * transaction. */
+VLC_API uint64_t vlc_apple_audio_session_transaction_generation(void);
+VLC_API bool vlc_apple_audio_session_transaction_is_current(
+    uint64_t generation, uint64_t media_services_epoch);
+
+/** Generation-tagged activation-owner accounting. These functions are called
+ * with the Apple audio-session lock held. */
+VLC_API bool vlc_apple_audio_session_acquire_owner(uint64_t epoch);
+VLC_API bool vlc_apple_audio_session_release_owner(uint64_t epoch);
+VLC_API void vlc_apple_audio_session_drop_owner(uint64_t epoch);
+VLC_API bool vlc_apple_audio_session_can_deactivate(void);
+VLC_API void vlc_apple_audio_session_report_deactivation(bool success);
+/** Execute and evidence one true-final-owner physical deactivation. The
+ * caller holds the recursive broker lock and passes an AVAudioSession as an
+ * opaque pointer plus AVAudioSessionSetActiveOptions bits. */
+VLC_API bool vlc_apple_audio_session_deactivate_final_owner(
+    void *session, uint64_t epoch, unsigned long options);
+
+/** Unique process-broker leases used by SwiftVLC's video-only/PiP owner. */
+VLC_API int vlc_apple_audio_session_acquire_lease(const void *owner,
+                                                  uint64_t *lease);
+VLC_API bool vlc_apple_audio_session_release_lease(const void *owner,
+                                                   uint64_t lease);
+VLC_API void vlc_apple_audio_session_release_all_leases(const void *owner);
+
