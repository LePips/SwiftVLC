+ * (at your option) any later version.
+ *****************************************************************************/
+
+#import "config.h"
+
+#import <vlc_apple_audio_session.h>
+#import <vlc_atomic.h>
+#import <vlc_threads.h>
+
+#import <TargetConditionals.h>
+#import <Foundation/Foundation.h>
+#if !TARGET_OS_WATCH
+# import <AudioToolbox/AudioToolbox.h>
+#endif
+#if (TARGET_OS_IPHONE && !TARGET_OS_WATCH) || TARGET_OS_TV || \
+    (defined(TARGET_OS_VISION) && TARGET_OS_VISION)
+# import <AVFoundation/AVFoundation.h>
+# define VLC_APPLE_HAS_AUDIO_SESSION 1
+#else
+# define VLC_APPLE_HAS_AUDIO_SESSION 0
+#endif
+
+#define MEDIA_SERVICES_STATE_LOST UINT64_C(1)
+#define MEDIA_SERVICES_STATE_RESET UINT64_C(2)
+#define MEDIA_SERVICES_STATE_EPOCH_SHIFT 2
+#define RECENT_NOTIFICATION_LIMIT 64
+
+static vlc_mutex_t session_lock;
+static vlc_once_t session_lock_once = VLC_STATIC_ONCE;
+static uint64_t session_transaction_generation;
+/* One wait-free word is safe from the real-time latency/render path. */
+/* Epoch zero is reserved as the no-owner/no-reset sentinel. Initial ready is
+ * a nonzero epoch with neither Lost nor Reset set. */
+static atomic_uint_fast64_t media_services_state =
+    UINT64_C(1) << MEDIA_SERVICES_STATE_EPOCH_SHIFT;
+static atomic_flag snapshot_writer_lock = ATOMIC_FLAG_INIT;
+static atomic_uint_fast64_t snapshot_state_generation;
+static atomic_uint active_owner_count;
+static atomic_uint active_lease_count;
+static atomic_uint_fast64_t successful_deactivation_count;
+static atomic_uint_fast64_t failed_deactivation_count;
+static char event_queue_key;
+
+struct vlc_apple_audio_render_context
+{
+    atomic_bool callbacks_accepted;
+    atomic_uint active_callbacks;
+    void *payload;
+};
+
+@interface VLCAppleAudioSessionBroker : NSObject
+{
+    NSMutableArray<NSNotification *> *_recentNotifications;
+    NSMutableArray<NSNumber *> *_recentEpochs;
+    NSMutableArray<NSNumber *> *_recentResetPhases;
+    NSMutableArray<NSValue *> *_orphanedAudioUnits;
+    NSMutableArray<NSValue *> *_orphanedAudioUnitContexts;
+    NSMutableArray<NSValue *> *_orphanedCFObjects;
+    NSMutableArray<NSNumber *> *_leaseTokens;
+    NSMutableArray<NSValue *> *_leaseOwners;
+    NSMutableArray<NSNumber *> *_leaseEpochs;
+    uint64_t _nextLeaseToken;
+    dispatch_queue_t _eventQueue;
+}
++ (instancetype)sharedBroker;
+- (uint64_t)recordNotification:(NSNotification *)notification reset:(BOOL)reset;
+- (void)orphanAudioUnit:(void *)audioUnit
+          renderContext:(struct vlc_apple_audio_render_context *)context;
+- (void)orphanCFObject:(CFTypeRef)object;
+- (uint64_t)addLeaseForOwner:(const void *)owner epoch:(uint64_t)epoch;
+- (uint64_t)leaseForOwner:(const void *)owner epoch:(uint64_t)epoch;
+- (void)discardLeasesNotInEpoch:(uint64_t)epoch;
+- (uint64_t)consumeLease:(uint64_t)token owner:(const void *)owner;
+- (NSArray<NSNumber *> *)consumeAllLeasesForOwner:(const void *)owner;
+@end
+
+static void
+BeginSnapshotMutation(void)
+{
+    while (atomic_flag_test_and_set_explicit(&snapshot_writer_lock,
+                                              memory_order_acquire))
+        ;
+    uint64_t generation = atomic_fetch_add_explicit(
+        &snapshot_state_generation, 1, memory_order_acq_rel) + 1;
+    assert((generation & 1) != 0);
+}
+
+static void
+EndSnapshotMutation(void)
+{
+    uint64_t generation = atomic_fetch_add_explicit(
+        &snapshot_state_generation, 1, memory_order_release) + 1;
+    assert((generation & 1) == 0);
+    atomic_flag_clear_explicit(&snapshot_writer_lock, memory_order_release);
+}
+
+static struct vlc_apple_audio_session_snapshot
+ReadSnapshotUnchecked(void)
+{
+    uint64_t state = atomic_load_explicit(&media_services_state,
+                                          memory_order_acquire);
+    struct vlc_apple_audio_session_snapshot snapshot = {
+        .epoch = state >> MEDIA_SERVICES_STATE_EPOCH_SHIFT,
+        .lost = (state & MEDIA_SERVICES_STATE_LOST) != 0,
+        .active_owner_count = atomic_load_explicit(&active_owner_count,
+                                                   memory_order_acquire),
+        .live_lease_count = atomic_load_explicit(&active_lease_count,
+                                                 memory_order_acquire),
+        .successful_deactivation_count = atomic_load_explicit(
+            &successful_deactivation_count, memory_order_acquire),
+        .failed_deactivation_count = atomic_load_explicit(
+            &failed_deactivation_count, memory_order_acquire),
+    };
+    snapshot.reset_epoch = (state & MEDIA_SERVICES_STATE_RESET) != 0
+                         ? snapshot.epoch : 0;
+    return snapshot;
+}
+
+static struct vlc_apple_audio_session_snapshot
+ReadSnapshot(void)
+{
+    for (;;)
+    {
+        uint64_t before = atomic_load_explicit(&snapshot_state_generation,
+                                                memory_order_acquire);
+        if ((before & 1) != 0)
+            continue;
+        struct vlc_apple_audio_session_snapshot snapshot =
+            ReadSnapshotUnchecked();
+        atomic_thread_fence(memory_order_acquire);
+        uint64_t after = atomic_load_explicit(&snapshot_state_generation,
+                                               memory_order_relaxed);
+        if (before == after && (after & 1) == 0)
+        {
+            snapshot.state_generation = after;
+            return snapshot;
+        }
+    }
+}
+
+struct vlc_apple_audio_render_context *
+vlc_apple_audio_render_context_create(void *payload)
+{
+    struct vlc_apple_audio_render_context *context = malloc(sizeof(*context));
+    if (unlikely(context == NULL))
+        return NULL;
+    atomic_init(&context->callbacks_accepted, true);
+    atomic_init(&context->active_callbacks, 0);
+    context->payload = payload;
+    return context;
+}
+
+void *vlc_apple_audio_render_context_begin(
+    struct vlc_apple_audio_render_context *context)
+{
+    if (context == NULL
+     || !atomic_load_explicit(&context->callbacks_accepted,
+                              memory_order_acquire))
+        return NULL;
+
+    atomic_fetch_add_explicit(&context->active_callbacks, 1,
+                              memory_order_acq_rel);
+    if (!atomic_load_explicit(&context->callbacks_accepted,
+                              memory_order_acquire))
+    {
+        atomic_fetch_sub_explicit(&context->active_callbacks, 1,
+                                  memory_order_release);
+        return NULL;
+    }
+    return context->payload;
+}
+
+void vlc_apple_audio_render_context_end(
+    struct vlc_apple_audio_render_context *context)
+{
+    assert(context != NULL);
+    unsigned previous = atomic_fetch_sub_explicit(&context->active_callbacks,
+                                                   1, memory_order_release);
+    assert(previous != 0);
+}
+
+void vlc_apple_audio_render_context_invalidate(
+    struct vlc_apple_audio_render_context *context)
+{
+    if (context != NULL)
+        atomic_store_explicit(&context->callbacks_accepted, false,
+                              memory_order_release);
+}
+
+void vlc_apple_audio_render_context_destroy(
+    struct vlc_apple_audio_render_context *context)
+{
+    if (context == NULL)
+        return;
+    vlc_apple_audio_render_context_invalidate(context);
+    while (atomic_load_explicit(&context->active_callbacks,
+                                memory_order_acquire) != 0)
+        vlc_tick_sleep(VLC_TICK_FROM_MS(1));
+    free(context);
+}
+
+@implementation VLCAppleAudioSessionBroker
+
++ (instancetype)sharedBroker
+{
+    static VLCAppleAudioSessionBroker *broker;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        broker = [[self alloc] init];
+    });
+    return broker;
+}
+
+- (instancetype)init
+{
+    self = [super init];
+    if (self == nil)
+        return nil;
+
+    _recentNotifications = [[NSMutableArray alloc] init];
+    _recentEpochs = [[NSMutableArray alloc] init];
+    _recentResetPhases = [[NSMutableArray alloc] init];
+    _orphanedAudioUnits = [[NSMutableArray alloc] init];
+    _orphanedAudioUnitContexts = [[NSMutableArray alloc] init];
+    _orphanedCFObjects = [[NSMutableArray alloc] init];
+    _leaseTokens = [[NSMutableArray alloc] init];
+    _leaseOwners = [[NSMutableArray alloc] init];
+    _leaseEpochs = [[NSMutableArray alloc] init];
+    _nextLeaseToken = 0;
+    _eventQueue = dispatch_queue_create(
+        "org.videolan.vlc.apple-audio-session-events", DISPATCH_QUEUE_SERIAL);
+    dispatch_queue_set_specific(_eventQueue, &event_queue_key,
+                                &event_queue_key, NULL);
+
+#if VLC_APPLE_HAS_AUDIO_SESSION
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+    [center addObserver:self
+               selector:@selector(mediaServicesWereLost:)
+                   name:AVAudioSessionMediaServicesWereLostNotification
+                 object:nil];
+    [center addObserver:self
+               selector:@selector(mediaServicesWereReset:)
+                   name:AVAudioSessionMediaServicesWereResetNotification
+                 object:nil];
+#endif
+    return self;
+}
+
+- (void)mediaServicesWereLost:(NSNotification *)notification
+{
+    [self recordNotification:notification reset:NO];
+}
+
+- (void)mediaServicesWereReset:(NSNotification *)notification
+{
+    [self recordNotification:notification reset:YES];
+}
+
+- (BOOL)disposeAudioUnit:(void *)audioUnit
+           renderContext:(struct vlc_apple_audio_render_context *)context
+{
+#if !TARGET_OS_WATCH
+    OSStatus status = AudioComponentInstanceDispose((AudioUnit)audioUnit);
+    if (status != noErr)
+    {
+        /* The unit may still retain and invoke its render refCon after a
+         * failed dispose. Keep the already-invalidated context paired with
+         * the unit and retry once on a later Reset; freeing it here would be
+         * a use-after-free. */
+        NSLog(@"SwiftVLC AudioComponentInstanceDispose failed (%d); "
+              "retaining invalidated unit/context for a later reset retry",
+              (int)status);
+        return NO;
+    }
+#else
+    (void) audioUnit;
+    vlc_assert_unreachable();
+#endif
+    if (context != NULL)
+        vlc_apple_audio_render_context_destroy(context);
+    return YES;
+}
+
+- (void)drainOrphansOnEventQueue
+{
+    assert(dispatch_get_specific(&event_queue_key) != NULL);
+
+    /* Move each collection aside so a failed disposal can be requeued without
+     * being retried in a tight loop. One Reset performs at most one attempt
+     * per retained object; failure intentionally preserves a safe leak until
+     * a later Reset rather than freeing callback state still owned by Apple. */
+    NSArray<NSValue *> *audioUnits = [_orphanedAudioUnits copy];
+    NSArray<NSValue *> *contexts = [_orphanedAudioUnitContexts copy];
+    [_orphanedAudioUnits removeAllObjects];
+    [_orphanedAudioUnitContexts removeAllObjects];
+    assert(audioUnits.count == contexts.count);
+    for (NSUInteger i = 0; i < audioUnits.count; ++i)
+    {
+        void *audioUnit = audioUnits[i].pointerValue;
+        struct vlc_apple_audio_render_context *context =
+            contexts[i].pointerValue;
+        if (ReadSnapshot().lost
+         || ![self disposeAudioUnit:audioUnit renderContext:context])
+        {
+            [_orphanedAudioUnits addObject:audioUnits[i]];
+            [_orphanedAudioUnitContexts addObject:contexts[i]];
+        }
+    }
+    NSArray<NSValue *> *cfObjects = [_orphanedCFObjects copy];
+    [_orphanedCFObjects removeAllObjects];
+    for (NSValue *value in cfObjects)
+    {
+        if (ReadSnapshot().lost)
+            [_orphanedCFObjects addObject:value];
+        else
+            CFRelease((CFTypeRef)value.pointerValue);
+    }
+}
+
+- (uint64_t)recordNotificationOnEventQueue:(NSNotification *)notification
+                                     reset:(BOOL)reset
+{
+    assert(dispatch_get_specific(&event_queue_key) != NULL);
+    NSUInteger index = [_recentNotifications indexOfObjectIdenticalTo:notification];
+    if (index != NSNotFound)
+    {
+        /* A delayed callback must receive its original epoch. */
+        if (_recentResetPhases[index].boolValue != reset)
+            return 0;
+        return _recentEpochs[index].unsignedLongLongValue;
+    }
+
+    struct vlc_apple_audio_session_snapshot old = ReadSnapshot();
+    uint64_t epoch = old.epoch + 1;
+    if (unlikely(epoch == 0
+              || epoch > (UINT64_MAX >> MEDIA_SERVICES_STATE_EPOCH_SHIFT)))
+        epoch = 1;
+    uint64_t state = epoch << MEDIA_SERVICES_STATE_EPOCH_SHIFT;
+    if (reset)
+        state |= MEDIA_SERVICES_STATE_RESET;
+    else
+        state |= MEDIA_SERVICES_STATE_LOST;
+    BeginSnapshotMutation();
+    atomic_store_explicit(&active_owner_count, 0, memory_order_relaxed);
+    atomic_store_explicit(&active_lease_count, 0, memory_order_relaxed);
+    atomic_store_explicit(&media_services_state, state, memory_order_relaxed);
+    EndSnapshotMutation();
+
+    [_recentNotifications addObject:notification];
+    [_recentEpochs addObject:@(epoch)];
+    [_recentResetPhases addObject:@(reset)];
+    if (_recentNotifications.count > RECENT_NOTIFICATION_LIMIT)
+    {
+        [_recentNotifications removeObjectAtIndex:0];
+        [_recentEpochs removeObjectAtIndex:0];
+        [_recentResetPhases removeObjectAtIndex:0];
+    }
+
+    if (reset)
+        dispatch_async(_eventQueue, ^{ [self drainOrphansOnEventQueue]; });
+    return epoch;
+}
+
+- (uint64_t)recordNotification:(NSNotification *)notification reset:(BOOL)reset
+{
+    if (notification == nil)
+        return 0;
+    if (dispatch_get_specific(&event_queue_key) != NULL)
+        return [self recordNotificationOnEventQueue:notification reset:reset];
+
+    __block uint64_t epoch;
+    dispatch_sync(_eventQueue, ^{
+        epoch = [self recordNotificationOnEventQueue:notification reset:reset];
+    });
+    return epoch;
+}
+
+- (void)orphanAudioUnit:(void *)audioUnit
+          renderContext:(struct vlc_apple_audio_render_context *)context
+{
+    if (audioUnit == NULL)
+    {
+        if (context != NULL)
+            vlc_apple_audio_render_context_destroy(context);
+        return;
+    }
+    dispatch_block_t block = ^{
+        if (ReadSnapshot().lost)
+        {
+            [_orphanedAudioUnits addObject:[NSValue valueWithPointer:audioUnit]];
+            [_orphanedAudioUnitContexts addObject:
+                [NSValue valueWithPointer:context]];
+        }
+        else if (![self disposeAudioUnit:audioUnit renderContext:context])
+        {
+            [_orphanedAudioUnits addObject:[NSValue valueWithPointer:audioUnit]];
+            [_orphanedAudioUnitContexts addObject:
+                [NSValue valueWithPointer:context]];
+        }
+    };
+    if (dispatch_get_specific(&event_queue_key) != NULL)
+        block();
+    else
+        dispatch_sync(_eventQueue, block);
+}
+
+- (void)orphanCFObject:(CFTypeRef)object
+{
+    if (object == NULL)
+        return;
+    dispatch_block_t block = ^{
+        if (ReadSnapshot().lost)
+            [_orphanedCFObjects addObject:[NSValue valueWithPointer:object]];
+        else
+            CFRelease(object);
+    };
+    if (dispatch_get_specific(&event_queue_key) != NULL)
+        block();
+    else
+        dispatch_sync(_eventQueue, block);
+}
+
+- (uint64_t)addLeaseForOwner:(const void *)owner epoch:(uint64_t)epoch
+{
+    uint64_t token = [self leaseForOwner:owner epoch:epoch];
+    if (token != 0)
+        return token;
+
+    do
+    {
+        token = ++_nextLeaseToken;
+        if (unlikely(token == 0))
+            token = ++_nextLeaseToken;
+    }
+    while ([_leaseTokens containsObject:@(token)]);
+    [_leaseTokens addObject:@(token)];
+    [_leaseOwners addObject:[NSValue valueWithPointer:owner]];
+    [_leaseEpochs addObject:@(epoch)];
+    return token;
+}
+
+- (uint64_t)leaseForOwner:(const void *)owner epoch:(uint64_t)epoch
+{
+    for (NSInteger i = (NSInteger)_leaseOwners.count - 1; i >= 0; --i)
+    {
+        NSUInteger index = (NSUInteger)i;
+        if (_leaseOwners[index].pointerValue != owner)
+            continue;
+        if (_leaseEpochs[index].unsignedLongLongValue == epoch)
+            return _leaseTokens[index].unsignedLongLongValue;
+    }
+    return 0;
+}
+
+- (void)discardLeasesNotInEpoch:(uint64_t)epoch
+{
+    /* Media-services phase changes atomically invalidate the logical owner
+     * counts. Retire their matching opaque records lazily under the normal
+     * serialized lease transaction so repeated Reset -> acquire cycles cannot
+     * grow the process table, while notification callbacks remain lock-free. */
+    for (NSInteger i = (NSInteger)_leaseEpochs.count - 1; i >= 0; --i)
+    {
+        NSUInteger index = (NSUInteger)i;
+        if (_leaseEpochs[index].unsignedLongLongValue == epoch)
+            continue;
+        [_leaseTokens removeObjectAtIndex:index];
+        [_leaseOwners removeObjectAtIndex:index];
+        [_leaseEpochs removeObjectAtIndex:index];
+    }
+}
+
+- (uint64_t)consumeLease:(uint64_t)token owner:(const void *)owner
+{
+    NSUInteger index = [_leaseTokens indexOfObject:@(token)];
+    if (index == NSNotFound || _leaseOwners[index].pointerValue != owner)
+        return 0;
+    uint64_t epoch = _leaseEpochs[index].unsignedLongLongValue;
+    [_leaseTokens removeObjectAtIndex:index];
+    [_leaseOwners removeObjectAtIndex:index];
+    [_leaseEpochs removeObjectAtIndex:index];
+    return epoch;
+}
+
+- (NSArray<NSNumber *> *)consumeAllLeasesForOwner:(const void *)owner
+{
+    NSMutableArray<NSNumber *> *epochs = [[NSMutableArray alloc] init];
+    for (NSInteger i = (NSInteger)_leaseOwners.count - 1; i >= 0; --i)
+    {
+        if (_leaseOwners[(NSUInteger)i].pointerValue != owner)
+            continue;
+        [epochs addObject:_leaseEpochs[(NSUInteger)i]];
+        [_leaseTokens removeObjectAtIndex:(NSUInteger)i];
+        [_leaseOwners removeObjectAtIndex:(NSUInteger)i];
+        [_leaseEpochs removeObjectAtIndex:(NSUInteger)i];
+    }
+    return epochs;
+}
+
+@end
+
+static uint64_t
+CurrentLeaseForOwner(VLCAppleAudioSessionBroker *broker, const void *owner)
+{
+    struct vlc_apple_audio_session_snapshot current = ReadSnapshot();
+    if (current.lost || current.epoch == 0)
+        return 0;
+    return [broker leaseForOwner:owner epoch:current.epoch];
+}
+
+__attribute__((constructor))
+static void InitializeAppleAudioSessionBroker(void)
+{
+    (void) [VLCAppleAudioSessionBroker sharedBroker];
+}
+
+static void InitializeAppleAudioSessionLock(void *opaque)
+{
+    (void) opaque;
+    vlc_mutex_init_recursive(&session_lock);
+}
+
+uint64_t
+vlc_apple_audio_session_media_services_event(const void *notification,
+                                             bool reset)
+{
+    NSNotification *note = (__bridge NSNotification *)notification;
+    return [[VLCAppleAudioSessionBroker sharedBroker]
+        recordNotification:note reset:reset];
+}
+
+struct vlc_apple_audio_session_snapshot
+vlc_apple_audio_session_snapshot(void)
+{
+    return ReadSnapshot();
+}
+
+void vlc_apple_audio_session_lock(void)
+{
+    vlc_once(&session_lock_once, InitializeAppleAudioSessionLock, NULL);
+    vlc_mutex_lock(&session_lock);
+    if (unlikely(++session_transaction_generation == 0))
+        ++session_transaction_generation;
+}
+
+uint64_t vlc_apple_audio_session_transaction_generation(void)
+{
+    return session_transaction_generation;
+}
+
+bool
+vlc_apple_audio_session_transaction_is_current(uint64_t generation,
+                                               uint64_t epoch)
+{
+    struct vlc_apple_audio_session_snapshot snapshot = ReadSnapshot();
+    return generation != 0 && generation == session_transaction_generation
+        && !snapshot.lost && snapshot.epoch == epoch;
+}
+
+void vlc_apple_audio_session_unlock(void)
+{
+    vlc_mutex_unlock(&session_lock);
+}
+
+bool vlc_apple_audio_session_acquire_owner(uint64_t epoch)
+{
+    if (epoch == 0)
+        return false;
+    struct vlc_apple_audio_session_snapshot before = ReadSnapshot();
+    if (before.lost || before.epoch != epoch)
+        return false;
+    BeginSnapshotMutation();
+    atomic_fetch_add_explicit(&active_owner_count, 1, memory_order_relaxed);
+    struct vlc_apple_audio_session_snapshot after = ReadSnapshotUnchecked();
+    if (after.lost || after.epoch != epoch)
+    {
+        /* A phase change invalidates every previous-generation owner. */
+        atomic_store_explicit(&active_owner_count, 0, memory_order_relaxed);
+        EndSnapshotMutation();
+        return false;
+    }
+    EndSnapshotMutation();
+    return true;
+}
+
+bool vlc_apple_audio_session_release_owner(uint64_t epoch)
+{
+    if (epoch == 0)
+        return false;
+    BeginSnapshotMutation();
+    struct vlc_apple_audio_session_snapshot snapshot = ReadSnapshotUnchecked();
+    unsigned count = atomic_load_explicit(&active_owner_count,
+                                          memory_order_relaxed);
+    if (snapshot.lost || snapshot.epoch != epoch || count == 0)
+    {
+        EndSnapshotMutation();
+        return false;
+    }
+    atomic_store_explicit(&active_owner_count, count - 1,
+                          memory_order_relaxed);
+    bool final = count == 1;
+    EndSnapshotMutation();
+    return final;
+}
+
+void vlc_apple_audio_session_drop_owner(uint64_t epoch)
+{
+    (void) vlc_apple_audio_session_release_owner(epoch);
+}
+
+bool vlc_apple_audio_session_can_deactivate(void)
+{
+    struct vlc_apple_audio_session_snapshot snapshot = ReadSnapshot();
+    return !snapshot.lost && snapshot.active_owner_count == 0;
+}
+
+void vlc_apple_audio_session_report_deactivation(bool success)
+{
+    atomic_uint_fast64_t *counter = success
+        ? &successful_deactivation_count : &failed_deactivation_count;
+    BeginSnapshotMutation();
+    atomic_fetch_add_explicit(counter, 1, memory_order_relaxed);
+    EndSnapshotMutation();
+}
+
+bool
+vlc_apple_audio_session_deactivate_final_owner(void *opaque_session,
+                                               uint64_t epoch,
+                                               unsigned long options)
+{
+#if VLC_APPLE_HAS_AUDIO_SESSION
+    AVAudioSession *session = (__bridge AVAudioSession *)opaque_session;
+    if (session == nil || epoch == 0)
+        return false;
+    struct vlc_apple_audio_session_snapshot before = ReadSnapshot();
+    if (before.lost || before.epoch != epoch || before.active_owner_count != 0)
+        return true;
+
+    uint64_t transaction =
+        vlc_apple_audio_session_transaction_generation();
+    NSError *error = nil;
+    BOOL deactivated = [session setActive:NO
+                         withOptions:(AVAudioSessionSetActiveOptions)options
+                               error:&error];
+    BOOL successor_active = YES;
+    struct vlc_apple_audio_session_snapshot after = ReadSnapshot();
+    if (!after.lost && after.epoch == epoch
+     && after.active_owner_count != 0
+     && transaction != vlc_apple_audio_session_transaction_generation())
+    {
+        /* A synchronous notification acquired a successor while the outer
+         * final release was inside setActive:NO. Reassert active state so the
+         * newly counted owner is not stranded behind the stale transaction. */
+        successor_active = [session setActive:YES withOptions:0 error:&error];
+    }
+    BOOL completed = deactivated && successor_active;
+    vlc_apple_audio_session_report_deactivation(completed);
+    if (!completed)
+        NSLog(@"SwiftVLC AVAudioSession final deactivation/reassert failed: %@",
+              error ?: @"unknown error");
+    return completed;
+#else
+    (void) opaque_session;
+    (void) epoch;
+    (void) options;
+    return false;
+#endif
+}
+
+static bool AcquireCurrentLeaseCounts(uint64_t epoch)
+{
+    if (epoch == 0)
+        return false;
+    BeginSnapshotMutation();
+    struct vlc_apple_audio_session_snapshot snapshot = ReadSnapshotUnchecked();
+    if (snapshot.lost || snapshot.epoch != epoch)
+    {
+        EndSnapshotMutation();
+        return false;
+    }
+    atomic_fetch_add_explicit(&active_owner_count, 1, memory_order_relaxed);
+    atomic_fetch_add_explicit(&active_lease_count, 1, memory_order_relaxed);
+    EndSnapshotMutation();
+    return true;
+}
+
+static bool ReleaseCurrentLeaseCounts(uint64_t epoch)
+{
+    if (epoch == 0)
+        return false;
+    BeginSnapshotMutation();
+    struct vlc_apple_audio_session_snapshot snapshot = ReadSnapshotUnchecked();
+    unsigned leases = atomic_load_explicit(&active_lease_count,
+                                           memory_order_relaxed);
+    unsigned owners = atomic_load_explicit(&active_owner_count,
+                                           memory_order_relaxed);
+    if (snapshot.lost || snapshot.epoch != epoch
+     || leases == 0 || owners == 0)
+    {
+        EndSnapshotMutation();
+        return false;
+    }
+    atomic_store_explicit(&active_lease_count, leases - 1,
+                          memory_order_relaxed);
+    atomic_store_explicit(&active_owner_count, owners - 1,
+                          memory_order_relaxed);
+    bool final = owners == 1;
+    EndSnapshotMutation();
+    return final;
+}
+
+int vlc_apple_audio_session_acquire_lease(const void *owner, uint64_t *lease)
+{
+    if (owner == NULL || lease == NULL)
+        return VLC_EINVAL;
+    *lease = 0;
+#if VLC_APPLE_HAS_AUDIO_SESSION
+    vlc_apple_audio_session_lock();
+    struct vlc_apple_audio_session_snapshot snapshot = ReadSnapshot();
+    if (snapshot.lost || snapshot.epoch == 0)
+    {
+        vlc_apple_audio_session_unlock();
+        return VLC_EGENERIC;
+    }
+    uint64_t transaction =
+        vlc_apple_audio_session_transaction_generation();
+    VLCAppleAudioSessionBroker *broker =
+        [VLCAppleAudioSessionBroker sharedBroker];
+    [broker discardLeasesNotInEpoch:snapshot.epoch];
+    uint64_t existing = [broker leaseForOwner:owner epoch:snapshot.epoch];
+    if (existing != 0)
+    {
+        *lease = existing;
+        vlc_apple_audio_session_unlock();
+        return VLC_SUCCESS;
+    }
+    NSError *error = nil;
+    AVAudioSession *session = [AVAudioSession sharedInstance];
+    BOOL configured = !snapshot.lost
+        && [session setCategory:AVAudioSessionCategoryPlayback
+                           mode:AVAudioSessionModeMoviePlayback
+                        options:0 error:&error];
+    if (!vlc_apple_audio_session_transaction_is_current(transaction,
+                                                        snapshot.epoch))
+    {
+        *lease = CurrentLeaseForOwner(broker, owner);
+        vlc_apple_audio_session_unlock();
+        return *lease != 0 ? VLC_SUCCESS : VLC_EGENERIC;
+    }
+    BOOL did_activate = configured
+        && [session setActive:YES withOptions:0 error:&error];
+    if (!vlc_apple_audio_session_transaction_is_current(transaction,
+                                                        snapshot.epoch))
+    {
+        *lease = CurrentLeaseForOwner(broker, owner);
+        struct vlc_apple_audio_session_snapshot after_activation =
+            ReadSnapshot();
+        if (*lease == 0 && did_activate && !after_activation.lost
+         && after_activation.epoch == snapshot.epoch
+         && vlc_apple_audio_session_can_deactivate())
+            (void) vlc_apple_audio_session_deactivate_final_owner(
+                (__bridge void *)session, snapshot.epoch,
+                AVAudioSessionSetActiveOptionNotifyOthersOnDeactivation);
+        vlc_apple_audio_session_unlock();
+        return *lease != 0 ? VLC_SUCCESS : VLC_EGENERIC;
+    }
+    bool transaction_current =
+        vlc_apple_audio_session_transaction_is_current(transaction,
+                                                       snapshot.epoch);
+    bool owned = did_activate && transaction_current;
+    if (owned)
+    {
+        *lease = [broker addLeaseForOwner:owner epoch:snapshot.epoch];
+        owned = *lease != 0 && AcquireCurrentLeaseCounts(snapshot.epoch);
+        if (!owned || !vlc_apple_audio_session_transaction_is_current(
+                          transaction, snapshot.epoch))
+        {
+            uint64_t consumed = [broker consumeLease:*lease owner:owner];
+            if (owned && consumed == snapshot.epoch)
+                (void) ReleaseCurrentLeaseCounts(snapshot.epoch);
+            *lease = 0;
+            owned = false;
+        }
+    }
+    struct vlc_apple_audio_session_snapshot after = ReadSnapshot();
+    if (did_activate && !owned && !after.lost
+     && after.epoch == snapshot.epoch
+     && vlc_apple_audio_session_can_deactivate())
+        (void) vlc_apple_audio_session_deactivate_final_owner(
+            (__bridge void *)session, snapshot.epoch,
+            AVAudioSessionSetActiveOptionNotifyOthersOnDeactivation);
+    vlc_apple_audio_session_unlock();
+    return owned ? VLC_SUCCESS : VLC_EGENERIC;
+#else
+    return VLC_ENOTSUP;
+#endif
+}
+
+bool vlc_apple_audio_session_release_lease(const void *owner, uint64_t lease)
+{
+    if (owner == NULL || lease == 0)
+        return false;
+#if VLC_APPLE_HAS_AUDIO_SESSION
+    vlc_apple_audio_session_lock();
+    uint64_t epoch = [[VLCAppleAudioSessionBroker sharedBroker]
+        consumeLease:lease owner:owner];
+    struct vlc_apple_audio_session_snapshot snapshot = ReadSnapshot();
+    bool consumed_current = epoch != 0 && !snapshot.lost
+                         && snapshot.epoch == epoch;
+    bool deactivate = consumed_current
+                   && ReleaseCurrentLeaseCounts(epoch);
+    snapshot = ReadSnapshot();
+    if (deactivate && !snapshot.lost && snapshot.epoch == epoch)
+        (void) vlc_apple_audio_session_deactivate_final_owner(
+            (__bridge void *)[AVAudioSession sharedInstance], epoch,
+            AVAudioSessionSetActiveOptionNotifyOthersOnDeactivation);
+    vlc_apple_audio_session_unlock();
+    return consumed_current;
+#else
+    return false;
+#endif
+}
+
+void vlc_apple_audio_session_release_all_leases(const void *owner)
+{
+    if (owner == NULL)
+        return;
+#if VLC_APPLE_HAS_AUDIO_SESSION
+    vlc_apple_audio_session_lock();
+    NSArray<NSNumber *> *epochs = [[VLCAppleAudioSessionBroker sharedBroker]
+        consumeAllLeasesForOwner:owner];
+    uint64_t deactivate_epoch = 0;
+    for (NSNumber *epoch in epochs)
+    {
+        uint64_t candidate_epoch = epoch.unsignedLongLongValue;
+        if (ReleaseCurrentLeaseCounts(candidate_epoch))
+            deactivate_epoch = candidate_epoch;
+    }
+    struct vlc_apple_audio_session_snapshot snapshot = ReadSnapshot();
+    if (deactivate_epoch != 0 && !snapshot.lost
+     && snapshot.epoch == deactivate_epoch)
+        (void) vlc_apple_audio_session_deactivate_final_owner(
+            (__bridge void *)[AVAudioSession sharedInstance], deactivate_epoch,
+            AVAudioSessionSetActiveOptionNotifyOthersOnDeactivation);
+    vlc_apple_audio_session_unlock();
+#endif
+}
+
+void vlc_apple_audio_session_orphan_audio_unit(void *audio_unit)
+{
+    [[VLCAppleAudioSessionBroker sharedBroker] orphanAudioUnit:audio_unit
+                                                  renderContext:NULL];
+}
+
+void vlc_apple_audio_session_orphan_audio_unit_with_render_context(
+    void *audio_unit, struct vlc_apple_audio_render_context *context)
+{
+    if (context != NULL)
+        vlc_apple_audio_render_context_invalidate(context);
+    [[VLCAppleAudioSessionBroker sharedBroker] orphanAudioUnit:audio_unit
+                                                  renderContext:context];
+}
+
+void vlc_apple_audio_session_orphan_cf_objects(CFTypeRef first,
+                                               CFTypeRef second)
+{
+    VLCAppleAudioSessionBroker *broker =
+        [VLCAppleAudioSessionBroker sharedBroker];
+    [broker orphanCFObject:first];
+    [broker orphanCFObject:second];
+}
