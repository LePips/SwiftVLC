diff --git a/modules/stream_out/chromecast/chromecast_demux_duration.hpp b/modules/stream_out/chromecast/chromecast_demux_duration.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..633cc87f8dcf3bc539d649d7f68a290ad0d83c26
--- /dev/null
+++ b/modules/stream_out/chromecast/chromecast_demux_duration.hpp
@@ -0,0 +1,26 @@
+/*****************************************************************************
+ * chromecast_demux_duration.hpp: Cast duration classification
+ *****************************************************************************/
+
+#ifndef VLC_CHROMECAST_DEMUX_DURATION_HPP
+#define VLC_CHROMECAST_DEMUX_DURATION_HPP
+
+#include <vlc_common.h>
+#include <vlc_input_item.h>
+
+/* Query DEMUX_GET_LENGTH through the production caller and translate its
+ * duration/live pair into the Cast duration contract. A live demux can expose
+ * a positive seek-window length; that is still an indefinite stream, not VOD. */
+template <typename Query>
+static inline vlc_tick_t chromecast_query_demux_input_length(Query &&query)
+{
+    vlc_tick_t duration = VLC_TICK_INVALID;
+    bool live = false;
+    if (query(&duration, &live) != VLC_SUCCESS)
+        return VLC_TICK_INVALID;
+    if (live)
+        return INPUT_DURATION_INDEFINITE;
+    return duration > VLC_TICK_0 ? duration : VLC_TICK_INVALID;
+}
+
+#endif
diff --git a/modules/stream_out/chromecast/chromecast_protocol.hpp b/modules/stream_out/chromecast/chromecast_protocol.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..c6c9085362522d23bc1fc9a1926c9ba4bfc1f174
--- /dev/null
+++ b/modules/stream_out/chromecast/chromecast_protocol.hpp
@@ -0,0 +1,159 @@
+/*****************************************************************************
+ * chromecast_protocol.hpp: narrow, testable Chromecast protocol helpers
+ *****************************************************************************/
+
+#ifndef VLC_CHROMECAST_PROTOCOL_HPP
+#define VLC_CHROMECAST_PROTOCOL_HPP
+
+#include <cstdlib>
+#include <cstring>
+#include <iomanip>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <string_view>
+
+#ifndef _WIN32
+# include <arpa/inet.h>
+#endif
+
+#include <vlc_common.h>
+#include <vlc_input_item.h>
+#include <vlc_network.h>
+#include <vlc_url.h>
+
+extern "C" {
+#include "../../demux/json/json.h"
+}
+
+/* json_get_str() returns NULL for both a missing member and a member whose
+ * value is not a JSON string. Never construct std::string/string_view from
+ * that nullable pointer directly. */
+static inline std::string_view
+json_get_str_view(const struct json_object *object, const char *key)
+{
+    const char *value = json_get_str(object, key);
+    return value != NULL ? value : "";
+}
+
+/* The host embedded in a Cast content/artwork URL must be usable by another
+ * device. A scoped IPv6 literal ("%en0") is meaningful only to the sender,
+ * and an unscoped link-local literal cannot identify its interface to the
+ * receiver. Fail closed instead of publishing an unreachable URL. */
+static inline bool
+chromecast_ipv4_is_publishable(const struct in_addr &address)
+{
+    const uint32_t value = ntohl(address.s_addr);
+    return value != INADDR_ANY
+        && (value & UINT32_C(0xff000000)) != UINT32_C(0x7f000000)
+        && !IN_MULTICAST(value);
+}
+
+static inline bool
+chromecast_server_host_is_publishable(const std::string &host)
+{
+    if (host.empty() || host.find('%') != std::string::npos)
+        return false;
+
+    struct in_addr ipv4;
+    if (inet_pton(AF_INET, host.c_str(), &ipv4) == 1)
+        return chromecast_ipv4_is_publishable(ipv4);
+
+    struct in6_addr ipv6;
+    if (inet_pton(AF_INET6, host.c_str(), &ipv6) != 1)
+        return false;
+
+    if (IN6_IS_ADDR_V4MAPPED(&ipv6))
+    {
+        std::memcpy(&ipv4, &ipv6.s6_addr[12], sizeof(ipv4));
+        return chromecast_ipv4_is_publishable(ipv4);
+    }
+
+    return !IN6_IS_ADDR_UNSPECIFIED(&ipv6)
+        && !IN6_IS_ADDR_LOOPBACK(&ipv6)
+        && !IN6_IS_ADDR_LINKLOCAL(&ipv6)
+        && !IN6_IS_ADDR_MULTICAST(&ipv6);
+}
+
+static inline std::string
+chromecast_artwork_url(const std::string &base_url, const std::string &path)
+{
+    if (base_url.empty() || path.empty())
+        return {};
+    return base_url + path;
+}
+
+static inline std::string
+chromecast_restore_wrapped_artwork_url(const std::string &current_url,
+                                       const std::string &source_url,
+                                       const std::string &published_url)
+{
+    if (!source_url.empty() && !published_url.empty()
+     && current_url == published_url)
+        return source_url;
+    return current_url;
+}
+
+static inline std::string
+chromecast_server_base_url(const std::string &host, unsigned port)
+{
+    if (!chromecast_server_host_is_publishable(host))
+        return {};
+
+    vlc_url_t components{};
+    components.psz_protocol = const_cast<char *>("http");
+    components.psz_host = const_cast<char *>(host.c_str());
+    components.i_port = port;
+
+    std::unique_ptr<char, decltype(&std::free)> url(
+        vlc_uri_compose(&components), &std::free);
+    return url != nullptr ? std::string(url.get()) : std::string();
+}
+
+static inline const char *
+chromecast_stream_type(vlc_tick_t input_length)
+{
+    if (input_length > VLC_TICK_0)
+        return "BUFFERED";
+    if (input_length == INPUT_DURATION_INDEFINITE)
+        return "LIVE";
+    return "NONE";
+}
+
+static inline std::string
+chromecast_media_fields(const std::string &content_id, const std::string &mime,
+                        vlc_tick_t input_length)
+{
+    if (content_id.empty())
+        return {};
+
+    const bool buffered = input_length > VLC_TICK_0;
+    std::ostringstream fields;
+    fields << "\"contentId\":\"" << content_id << "\""
+           << ",\"streamType\":\"" << chromecast_stream_type(input_length)
+           << "\""
+           << ",\"contentType\":\"" << mime << "\"";
+    if (buffered)
+    {
+        fields.setf(std::ios_base::fixed, std::ios_base::floatfield);
+        fields << ",\"duration\":" << std::setprecision(6)
+               << secf_from_vlc_tick(input_length);
+    }
+    return fields.str();
+}
+
+static inline std::string
+chromecast_load_payload(const std::string &media, unsigned request_id)
+{
+    if (media.empty())
+        return {};
+
+    std::ostringstream payload;
+    payload << "{\"type\":\"LOAD\","
+            << "\"media\":{" << media << "},"
+            << "\"requestId\":" << request_id
+            << "}";
+    return payload.str();
+}
+
+#endif
