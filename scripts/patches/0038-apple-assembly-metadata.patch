     }
 }
 
+# Export the values consumed by the NASM wrapper for Apple Mach-O objects.
+# Unsupported Apple targets intentionally receive no metadata: a macho64
+# invocation then fails closed instead of being stamped as the wrong platform.
+configure_apple_nasm_metadata()
+{
+    unset VLC_APPLE_NASM_PLATFORM
+    unset VLC_APPLE_NASM_MIN_OS_VERSION
+    unset VLC_APPLE_NASM_SDK_VERSION
+
+    case "$VLC_HOST_PLATFORM" in
+        macOS) VLC_APPLE_NASM_PLATFORM=macos ;;
+        iOS) VLC_APPLE_NASM_PLATFORM=ios ;;
+        iOS-Simulator) VLC_APPLE_NASM_PLATFORM=iossimulator ;;
+        tvOS) VLC_APPLE_NASM_PLATFORM=tvos ;;
+        tvOS-Simulator) VLC_APPLE_NASM_PLATFORM=tvossimulator ;;
+        xrOS) VLC_APPLE_NASM_PLATFORM=xros ;;
+        xr-Simulator) VLC_APPLE_NASM_PLATFORM=xrsimulator ;;
+        macCatalyst) VLC_APPLE_NASM_PLATFORM=macCatalyst ;;
+        *) return 0 ;;
+    esac
+
+    VLC_APPLE_NASM_MIN_OS_VERSION=$VLC_DEPLOYMENT_TARGET
+    VLC_APPLE_NASM_SDK_VERSION=$VLC_APPLE_SDK_VERSION
+    export VLC_APPLE_NASM_PLATFORM
+    export VLC_APPLE_NASM_MIN_OS_VERSION
+    export VLC_APPLE_NASM_SDK_VERSION
+}
+
+# Install the wrapper in a per-build directory after the pinned extras/tools
+# NASM target has finished. contrib/src/main.mak puts extras/tools/build/bin
+# first again, so move its NASM binary aside before restoring the wrapper
+# directory to the front of PATH.
+install_apple_nasm_wrapper()
+{
+    local wrapper_source="$VLC_SCRIPT_DIR/nasm-wrapper.sh"
+    local wrapper_dir="$VLC_BUILD_DIR/apple-nasm-wrapper"
+    local wrapper_path="$wrapper_dir/nasm"
+    local tools_nasm="$VLC_SRC_DIR/extras/tools/build/bin/nasm"
+    local saved_tools_nasm="$VLC_SRC_DIR/extras/tools/build/bin/nasm.swiftvlc-real"
+    local real_nasm=
+    local real_nasm_dir=
+    local nasm_version=
+
+    [ -x "$wrapper_source" ] || abort_err "Apple NASM wrapper is not executable"
+    mkdir -p "$wrapper_dir" || abort_err "Failed creating Apple NASM wrapper directory"
+
+    if [ -e "$tools_nasm" ]; then
+        [ -x "$tools_nasm" ] || abort_err "Bundled NASM is not executable"
+        mv -f "$tools_nasm" "$saved_tools_nasm" \
+            || abort_err "Failed preserving bundled NASM"
+    fi
+
+    [ -e "$saved_tools_nasm" ] \
+        || abort_err "Pinned bundled NASM is missing after .buildnasm"
+    [ -x "$saved_tools_nasm" ] \
+        || abort_err "Preserved bundled NASM is not executable"
+    real_nasm=$saved_tools_nasm
+
+    real_nasm_dir=$(CDPATH= cd -- "$(dirname -- "$real_nasm")" && pwd -P) \
+        || abort_err "Failed resolving real NASM directory"
+    real_nasm="$real_nasm_dir/$(basename -- "$real_nasm")"
+    [ -x "$real_nasm" ] || abort_err "Real NASM is not executable"
+    nasm_version=$("$real_nasm" -v 2>/dev/null) \
+        || abort_err "Pinned bundled NASM failed its version probe"
+    case "$nasm_version" in
+        "NASM version 3.02"|"NASM version 3.02 "*) ;;
+        *) abort_err "Pinned bundled NASM must report exactly version 3.02 (got: $nasm_version)" ;;
+    esac
+
+    cp "$wrapper_source" "$wrapper_path" \
+        || abort_err "Failed installing Apple NASM wrapper"
+    chmod 755 "$wrapper_path" \
+        || abort_err "Failed making Apple NASM wrapper executable"
+
+    export VLC_APPLE_NASM_REAL="$real_nasm"
+    export PATH="$wrapper_dir:$PATH"
+    [ "$(command -v nasm)" = "$wrapper_path" ] \
+        || abort_err "Apple NASM wrapper did not take PATH precedence"
+}
+
 # Set the VLC_DEPLOYMENT_TARGET* flag options correctly
 # Globals:
 #   VLC_DEPLOYMENT_TARGET
@@ -548,6 +628,8 @@ readonly VLC_CONTRIB_INSTALL_DIR="$VLC_SRC_DIR/contrib/${VLC_HOST_ARCH}-${VLC_AP
 # VLC install dir
 readonly VLC_INSTALL_DIR="$VLC_BUILD_DIR/vlc-${VLC_APPLE_SDK_NAME}-${VLC_HOST_ARCH}"
 
+configure_apple_nasm_metadata
+
 echo "Build configuration"
 echo "  Platform:         $VLC_HOST_PLATFORM"
 echo "  Architecture:     $VLC_HOST_ARCH"
@@ -628,6 +710,8 @@ fi
 cd "$VLC_SRC_DIR/extras/tools" || abort_err "Failed cd to tools dir"
 ./bootstrap $TOOLS_BOOTSTRAP || abort_err "Bootstrapping tools failed"
 $MAKE || abort_err "Building tools failed"
+$MAKE .buildnasm || abort_err "Building pinned NASM 3.02 failed"
+install_apple_nasm_wrapper
 echo ""
 
 ##########################################################
diff --git a/extras/package/apple/nasm-wrapper.sh b/extras/package/apple/nasm-wrapper.sh
new file mode 100755
index 0000000000..7e2667fad3
--- /dev/null
+++ b/extras/package/apple/nasm-wrapper.sh
@@ -0,0 +1,147 @@
+#!/bin/sh
+# Add deterministic Apple LC_BUILD_VERSION metadata to NASM Mach-O objects.
+
+set -eu
+
+fail()
+{
+    echo "apple-nasm-wrapper: $*" >&2
+    exit 2
+}
+
+normalize_component()
+{
+    component="$1"
+    maximum="$2"
+    description="$3"
+
+    case "$component" in
+        ""|*[!0-9]*)
+            fail "$description is not an unsigned decimal integer"
+            ;;
+    esac
+
+    while [ "${component#0}" != "$component" ]; do
+        component="${component#0}"
+    done
+    component="${component:-0}"
+
+    component_length=${#component}
+    maximum_length=${#maximum}
+    if [ "$component_length" -gt "$maximum_length" ] ||
+       { [ "$component_length" -eq "$maximum_length" ] &&
+         [ "$component" -gt "$maximum" ]; }; then
+        fail "$description exceeds $maximum"
+    fi
+    printf '%s' "$component"
+}
+
+normalize_version()
+{
+    version="$1"
+    description="$2"
+
+    case "$version" in
+        ""|*[!0-9.]*|.*|*.|*..*)
+            fail "$description must use MAJOR.MINOR[.PATCH]"
+            ;;
+    esac
+
+    saved_ifs=$IFS
+    IFS=.
+    set -- $version
+    IFS=$saved_ifs
+    if [ "$#" -ne 2 ] && [ "$#" -ne 3 ]; then
+        fail "$description must use MAJOR.MINOR[.PATCH]"
+    fi
+
+    major=$(normalize_component "$1" 65535 "$description major version")
+    minor=$(normalize_component "$2" 255 "$description minor version")
+    patch=0
+    if [ "$#" -eq 3 ]; then
+        patch=$(normalize_component "$3" 255 "$description patch version")
+    fi
+    printf '%s,%s,%s' "$major" "$minor" "$patch"
+}
+
+real_nasm=${VLC_APPLE_NASM_REAL-}
+case "$real_nasm" in
+    /*) ;;
+    "") fail "VLC_APPLE_NASM_REAL is required" ;;
+    *) fail "VLC_APPLE_NASM_REAL must be an absolute path" ;;
+esac
+[ -x "$real_nasm" ] || fail "real NASM is not executable: $real_nasm"
+
+wrapper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
+wrapper_path="$wrapper_dir/$(basename -- "$0")"
+real_dir=$(CDPATH= cd -- "$(dirname -- "$real_nasm")" && pwd -P)
+real_path="$real_dir/$(basename -- "$real_nasm")"
+[ "$real_path" != "$wrapper_path" ] || fail "real NASM resolves to the wrapper"
+
+[ -z "${NASMENV-}" ] ||
+    fail "NASMENV must be empty for deterministic output metadata"
+
+output_format=
+format_argument_pending=0
+parse_options=1
+caller_build_version=0
+for argument in "$@"; do
+    case "$argument" in
+        *build_version*) caller_build_version=1 ;;
+    esac
+
+    if [ "$format_argument_pending" -eq 1 ]; then
+        output_format=$argument
+        format_argument_pending=0
+        continue
+    fi
+    if [ "$parse_options" -eq 0 ]; then
+        continue
+    fi
+
+    case "$argument" in
+        -@|-@?*)
+            fail "NASM response files are unsupported because they can hide output metadata"
+            ;;
+        --)
+            parse_options=0
+            ;;
+        -f|--format)
+            format_argument_pending=1
+            ;;
+        --format=*)
+            output_format=${argument#--format=}
+            ;;
+        -f=*)
+            output_format=${argument#-f=}
+            ;;
+        -f?*)
+            output_format=${argument#-f}
+            ;;
+    esac
+done
+
+if [ "$output_format" != macho64 ]; then
+    exec "$real_path" "$@"
+fi
+
+[ "$caller_build_version" -eq 0 ] ||
+    fail "caller supplied build_version metadata; refusing a duplicate pragma"
+
+platform=${VLC_APPLE_NASM_PLATFORM-}
+case "$platform" in
+    macos|ios|iossimulator|tvos|tvossimulator|xros|xrsimulator|macCatalyst)
+        ;;
+    "") fail "VLC_APPLE_NASM_PLATFORM is required for macho64" ;;
+    *) fail "unsupported VLC_APPLE_NASM_PLATFORM: $platform" ;;
+esac
+
+minimum_os=$(normalize_version \
+    "${VLC_APPLE_NASM_MIN_OS_VERSION-}" \
+    VLC_APPLE_NASM_MIN_OS_VERSION)
+sdk=$(normalize_version \
+    "${VLC_APPLE_NASM_SDK_VERSION-}" \
+    VLC_APPLE_NASM_SDK_VERSION)
+pragma="macho build_version $platform,$minimum_os sdk_version $sdk"
+
+exec "$real_path" --pragma "$pragma" "$@"
